// RUN: pto-test-opt %s -vmi-lower-unified-to-legacy -vmi-mask-granularity-assignment -vmi-layout-assignment | FileCheck %s

module {
  func.func private @callee(%x: !pto.vmi.vreg<128xf32>)
      -> !pto.vmi.vreg<128xf32> {
    %sum = pto.vmi.vadd %x, %x
        : !pto.vmi.vreg<128xf32>, !pto.vmi.vreg<128xf32>
        -> !pto.vmi.vreg<128xf32>
    return %sum : !pto.vmi.vreg<128xf32>
  }

  func.func @caller(%a: !pto.vmi.vreg<128xf16>) {
    %ea = pto.vmi.vcvt %a
        : !pto.vmi.vreg<128xf16> -> !pto.vmi.vreg<128xf32>
    %r = call @callee(%ea)
        : (!pto.vmi.vreg<128xf32>) -> !pto.vmi.vreg<128xf32>
    %sum = pto.vmi.vadd %r, %r
        : !pto.vmi.vreg<128xf32>, !pto.vmi.vreg<128xf32>
        -> !pto.vmi.vreg<128xf32>
    return
  }
}

// CHECK-LABEL: func.func private @callee(
// CHECK-SAME: %[[VAL_0:[a-zA-Z0-9_.$-]+]]: !pto.vmi.vreg<128xf32, #pto.vmi.layout<contiguous>>) -> !pto.vmi.vreg<128xf32, #pto.vmi.layout<contiguous>> {
// CHECK-NEXT: %[[VAL_1:[a-zA-Z0-9_.$-]+]] = pto.vmi.vadd %[[VAL_0]], %[[VAL_0]] : !pto.vmi.vreg<128xf32, #pto.vmi.layout<contiguous>>, !pto.vmi.vreg<128xf32, #pto.vmi.layout<contiguous>> -> !pto.vmi.vreg<128xf32, #pto.vmi.layout<contiguous>>
// CHECK-NEXT: return %[[VAL_1]] : !pto.vmi.vreg<128xf32, #pto.vmi.layout<contiguous>>
// CHECK-NEXT: }
// CHECK-LABEL: func.func @caller(
// CHECK-SAME: %[[VAL_0:[a-zA-Z0-9_.$-]+]]: !pto.vmi.vreg<128xf16, #pto.vmi.layout<contiguous>>) {
// CHECK-NEXT: %[[VAL_1:[a-zA-Z0-9_.$-]+]] = pto.vmi.extf %[[VAL_0]] : !pto.vmi.vreg<128xf16, #pto.vmi.layout<contiguous>> -> !pto.vmi.vreg<128xf32, #pto.vmi.layout<deinterleaved = 2>>
// CHECK-NEXT: %[[VAL_2:[a-zA-Z0-9_.$-]+]] = pto.vmi.ensure_layout %[[VAL_1]] : !pto.vmi.vreg<128xf32, #pto.vmi.layout<deinterleaved = 2>> -> !pto.vmi.vreg<128xf32, #pto.vmi.layout<contiguous>>
// CHECK-NEXT: %[[VAL_3:[a-zA-Z0-9_.$-]+]] = call @callee(%[[VAL_2]]) : (!pto.vmi.vreg<128xf32, #pto.vmi.layout<contiguous>>) -> !pto.vmi.vreg<128xf32, #pto.vmi.layout<contiguous>>
// CHECK-NEXT: %[[VAL_4:[a-zA-Z0-9_.$-]+]] = pto.vmi.vadd %[[VAL_3]], %[[VAL_3]] : !pto.vmi.vreg<128xf32, #pto.vmi.layout<contiguous>>, !pto.vmi.vreg<128xf32, #pto.vmi.layout<contiguous>> -> !pto.vmi.vreg<128xf32, #pto.vmi.layout<contiguous>>
// CHECK-NEXT: return
// CHECK-NEXT: }
