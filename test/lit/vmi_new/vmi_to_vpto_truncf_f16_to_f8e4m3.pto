// RUN: pto-test-opt %s -vmi-lower-unified-to-legacy -vmi-to-vpto | FileCheck %s

// A5 F2F has no direct f16 -> f8E4M3 form, so the unified vcvt stages through
// an exact f32 widen.  Source layout deinterleaved=2 (2 physical parts) and
// result layout contiguous keep their explicit layouts: the staged f32
// intermediate picks deinterleaved=4 so both cast legs stay legal without the
// layout solver.  The widen leg emits EVEN/ODD vcvt per f16 part; the
// f32 -> fp8 leg applies the user rnd/sat with the P0..P3 packed parts and
// vor-merges into one physical result vreg.

module {
  func.func @vmi_to_vpto_truncf_f16_to_f8e4m3(
      %even: !pto.vmi.vreg<128xf16, #pto.vmi.layout<deinterleaved = 2>>,
      %odd:  !pto.vmi.vreg<128xf16, #pto.vmi.layout<deinterleaved = 2>>)
      -> !pto.vreg<256xf8E4M3FN> {
    %wide = pto.vmi.vadd %even, %odd
        : !pto.vmi.vreg<128xf16, #pto.vmi.layout<deinterleaved = 2>>,
          !pto.vmi.vreg<128xf16, #pto.vmi.layout<deinterleaved = 2>>
        -> !pto.vmi.vreg<128xf16, #pto.vmi.layout<deinterleaved = 2>>
    %packed = pto.vmi.vcvt %wide {saturate = "SAT"}
        : !pto.vmi.vreg<128xf16, #pto.vmi.layout<deinterleaved = 2>>
        -> !pto.vmi.vreg<128xf8E4M3FN, #pto.vmi.layout<contiguous>>
    %p = "pto.vmi.unpack"(%packed)
        : (!pto.vmi.vreg<128xf8E4M3FN, #pto.vmi.layout<contiguous>>)
        -> !pto.vreg<256xf8E4M3FN>
    return %p : !pto.vreg<256xf8E4M3FN>
  }
}

// CHECK-LABEL: func.func @vmi_to_vpto_truncf_f16_to_f8e4m3(
// Widen leg: one EVEN and one ODD f16 -> f32 vcvt per deinterleaved part.
// CHECK: pto.vcvt {{.*}} {part = "EVEN"} : !pto.vreg<128xf16>, !pto.mask<b16> -> !pto.vreg<64xf32>
// CHECK: pto.vcvt {{.*}} {part = "EVEN"} : !pto.vreg<128xf16>, !pto.mask<b16> -> !pto.vreg<64xf32>
// CHECK: pto.vcvt {{.*}} {part = "ODD"} : !pto.vreg<128xf16>, !pto.mask<b16> -> !pto.vreg<64xf32>
// CHECK: pto.vcvt {{.*}} {part = "ODD"} : !pto.vreg<128xf16>, !pto.mask<b16> -> !pto.vreg<64xf32>
// Narrow leg: the f32 -> fp8 profile carries the user rnd default R and sat.
// CHECK: pto.vcvt {{.*}} {part = "P0", rnd = "R", sat = "SAT"} : !pto.vreg<64xf32>, !pto.mask<b32> -> !pto.vreg<256xf8E4M3FN>
// CHECK: pto.vcvt {{.*}} {part = "P1", rnd = "R", sat = "SAT"} : !pto.vreg<64xf32>, !pto.mask<b32> -> !pto.vreg<256xf8E4M3FN>
// CHECK: pto.vcvt {{.*}} {part = "P2", rnd = "R", sat = "SAT"} : !pto.vreg<64xf32>, !pto.mask<b32> -> !pto.vreg<256xf8E4M3FN>
// CHECK: pto.vcvt {{.*}} {part = "P3", rnd = "R", sat = "SAT"} : !pto.vreg<64xf32>, !pto.mask<b32> -> !pto.vreg<256xf8E4M3FN>
// CHECK-COUNT-3: pto.vor
// CHECK-NOT: pto.vmi.
// CHECK-NOT: !pto.vmi.
// CHECK-NOT: unrealized_conversion_cast
