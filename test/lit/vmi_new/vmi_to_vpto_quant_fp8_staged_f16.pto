// RUN: pto-test-opt %s -vmi-lower-unified-to-legacy -vmi-mask-granularity-assignment -vmi-layout-assignment -vmi-to-vpto | FileCheck %s

// f16 -> fp8 narrows have no direct A5 F2F form: the unified vcvt stages
// through an exact f32 widen, and the user rounding/saturate ride the
// f32 -> fp8 leg.  Half-up H is legal here because the f32 -> fp8 profile
// encodes R/A/H/Z.

module {
  func.func @vmi_to_vpto_quant_fp8_staged_f16(
      %src: !pto.ptr<f16, ub>,
      %dst: !pto.ptr<f8E4M3FN, ub>,
      %offset: index) {
    %wide = pto.vmi.vload %src[%offset]
        : !pto.ptr<f16, ub> -> !pto.vmi.vreg<256xf16>
    %packed = pto.vmi.vcvt %wide {rounding = "H", saturate = "SAT"}
        : !pto.vmi.vreg<256xf16> -> !pto.vmi.vreg<256xf8E4M3FN>
    pto.vmi.vstore %packed, %dst[%offset]
        : !pto.vmi.vreg<256xf8E4M3FN>, !pto.ptr<f8E4M3FN, ub>
    return
  }
}

// CHECK-LABEL: func.func @vmi_to_vpto_quant_fp8_staged_f16(
// Staged widen leg: exact f16 -> f32 vcvt on unpacked lane-stride views; the
// widen legs never carry rnd/sat.
// CHECK-COUNT-4: pto.vcvt {{.*}} {part = "EVEN"} : !pto.vreg<128xf16>, !pto.mask<b16> -> !pto.vreg<64xf32>
// Narrow leg: the user rounding/saturate ride the f32 -> fp8 profile.
// CHECK-COUNT-4: pto.vcvt {{.*}} {part = "P0", rnd = "H", sat = "SAT"} : !pto.vreg<64xf32>, !pto.mask<b32> -> !pto.vreg<256xf8E4M3FN>
// CHECK-NOT: pto.vmi.
// CHECK-NOT: !pto.vmi.
