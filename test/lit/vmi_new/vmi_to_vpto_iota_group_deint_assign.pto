// RUN: pto-test-opt %s -vmi-lower-unified-to-legacy -vmi-mask-granularity-assignment -vmi-layout-assignment | FileCheck %s --check-prefix=ASSIGN
// RUN: pto-test-opt %s -vmi-lower-unified-to-legacy -vmi-mask-granularity-assignment -vmi-layout-assignment -vmi-layout-rematerialize -vmi-to-vpto | FileCheck %s --check-prefix=LOWER

// Check layout assignment and lowering for F16 widening feeding grouped iota
// arithmetic. Pin the selected cast and group-consumer dataflow without forcing
// the former deinterleaved preference.

module {
  func.func @grouped_vci_elem_with_widen_deint(
      %base: f32, %src: !pto.vmi.vreg<128xf16>, %dst: !pto.ptr<f32, ub>) {
    %c0 = arith.constant 0 : index
    %c128 = arith.constant 128 : index
    %wide = pto.vmi.vcvt %src
        : !pto.vmi.vreg<128xf16> -> !pto.vmi.vreg<128xf32>
    %idx = pto.vmi.vci %base {group = 2 : i64}
        : f32 -> !pto.vmi.vreg<128xf32>
    %mask = pto.vmi.create_mask %c128
        : index -> !pto.vmi.mask<128xpred>
    %sum = pto.vmi.vadd %wide, %idx, %mask
        : !pto.vmi.vreg<128xf32>, !pto.vmi.vreg<128xf32>,
          !pto.vmi.mask<128xpred>
        -> !pto.vmi.vreg<128xf32>
    pto.vmi.vstore %sum, %dst[%c0]
        : !pto.vmi.vreg<128xf32>, !pto.ptr<f32, ub>
    return
  }
}
// Check the physical grouped arithmetic and store stream.

// ASSIGN-LABEL: func.func @grouped_vci_elem_with_widen_deint(
// ASSIGN-SAME: %[[VAL_0:[a-zA-Z0-9_.$-]+]]: f32,
// ASSIGN-SAME: %[[VAL_1:[a-zA-Z0-9_.$-]+]]: !pto.vmi.vreg<128xf16, #pto.vmi.layout<contiguous>>,
// ASSIGN-SAME: %[[VAL_2:[a-zA-Z0-9_.$-]+]]: !pto.ptr<f32, ub>) {
// ASSIGN-NEXT: %[[VAL_3:[a-zA-Z0-9_.$-]+]] = arith.constant 0 : index
// ASSIGN-NEXT: %[[VAL_4:[a-zA-Z0-9_.$-]+]] = arith.constant 128 : index
// ASSIGN-NEXT: %[[VAL_5:[a-zA-Z0-9_.$-]+]] = pto.vmi.extf %[[VAL_1]] : !pto.vmi.vreg<128xf16, #pto.vmi.layout<contiguous>> -> !pto.vmi.vreg<128xf32, #pto.vmi.layout<deinterleaved = 2>>
// ASSIGN-NEXT: %[[VAL_6:[a-zA-Z0-9_.$-]+]] = pto.vmi.group_iota %[[VAL_0]] {group = 2 : i64} : f32 -> !pto.vmi.vreg<128xf32, #pto.vmi.layout<contiguous>>
// ASSIGN-NEXT: %[[VAL_7:[a-zA-Z0-9_.$-]+]] = pto.vmi.create_mask %[[VAL_4]] : index -> !pto.vmi.mask<128xb32, #pto.vmi.layout<deinterleaved = 2>>
// ASSIGN-NEXT: %[[VAL_8:[a-zA-Z0-9_.$-]+]] = pto.vmi.ensure_layout %[[VAL_6]] : !pto.vmi.vreg<128xf32, #pto.vmi.layout<contiguous>> -> !pto.vmi.vreg<128xf32, #pto.vmi.layout<deinterleaved = 2>>
// ASSIGN-NEXT: %[[VAL_9:[a-zA-Z0-9_.$-]+]] = pto.vmi.vadd %[[VAL_5]], %[[VAL_8]], %[[VAL_7]] : !pto.vmi.vreg<128xf32, #pto.vmi.layout<deinterleaved = 2>>, !pto.vmi.vreg<128xf32, #pto.vmi.layout<deinterleaved = 2>>, !pto.vmi.mask<128xb32, #pto.vmi.layout<deinterleaved = 2>> -> !pto.vmi.vreg<128xf32, #pto.vmi.layout<deinterleaved = 2>>
// ASSIGN-NEXT: pto.vmi.store %[[VAL_9]], %[[VAL_2]]{{\[}}%[[VAL_3]]] : !pto.vmi.vreg<128xf32, #pto.vmi.layout<deinterleaved = 2>>, !pto.ptr<f32, ub>
// ASSIGN-NEXT: return
// ASSIGN-NEXT: }

// LOWER-LABEL: func.func @grouped_vci_elem_with_widen_deint(
// LOWER-SAME: %[[VAL_0:[a-zA-Z0-9_.$-]+]]: f32,
// LOWER-SAME: %[[VAL_1:[a-zA-Z0-9_.$-]+]]: !pto.vreg<128xf16>,
// LOWER-SAME: %[[VAL_2:[a-zA-Z0-9_.$-]+]]: !pto.ptr<f32, ub>) {
// LOWER-NEXT: %[[VAL_3:[a-zA-Z0-9_.$-]+]] = arith.constant 0 : index
// LOWER-NEXT: %[[VAL_4:[a-zA-Z0-9_.$-]+]] = pto.pset_b16 "PAT_ALL" : !pto.mask<b16>
// LOWER-NEXT: %[[VAL_5:[a-zA-Z0-9_.$-]+]] = pto.vcvt %[[VAL_1]], %[[VAL_4]] {part = "EVEN"} : !pto.vreg<128xf16>, !pto.mask<b16> -> !pto.vreg<64xf32>
// LOWER-NEXT: %[[VAL_6:[a-zA-Z0-9_.$-]+]] = pto.vcvt %[[VAL_1]], %[[VAL_4]] {part = "ODD"} : !pto.vreg<128xf16>, !pto.mask<b16> -> !pto.vreg<64xf32>
// LOWER-NEXT: %[[VAL_7:[a-zA-Z0-9_.$-]+]] = pto.vci %[[VAL_0]] : f32 -> !pto.vreg<64xf32>
// LOWER-NEXT: %[[VAL_8:[a-zA-Z0-9_.$-]+]] = pto.pset_b32 "PAT_ALL" : !pto.mask<b32>
// LOWER-NEXT: %[[VAL_9:[a-zA-Z0-9_.$-]+]] = pto.pset_b32 "PAT_ALL" : !pto.mask<b32>
// LOWER-NEXT: %[[VAL_10:[a-zA-Z0-9_.$-]+]], %[[VAL_11:[a-zA-Z0-9_.$-]+]] = pto.vdintlv %[[VAL_7]], %[[VAL_7]] : !pto.vreg<64xf32>, !pto.vreg<64xf32> -> !pto.vreg<64xf32>, !pto.vreg<64xf32>
// LOWER-NEXT: %[[VAL_12:[a-zA-Z0-9_.$-]+]] = pto.vadd %[[VAL_5]], %[[VAL_10]], %[[VAL_8]] : !pto.vreg<64xf32>, !pto.vreg<64xf32>, !pto.mask<b32> -> !pto.vreg<64xf32>
// LOWER-NEXT: %[[VAL_13:[a-zA-Z0-9_.$-]+]] = pto.vadd %[[VAL_6]], %[[VAL_11]], %[[VAL_9]] : !pto.vreg<64xf32>, !pto.vreg<64xf32>, !pto.mask<b32> -> !pto.vreg<64xf32>
// LOWER-NEXT: %[[VAL_14:[a-zA-Z0-9_.$-]+]] = pto.pset_b32 "PAT_ALL" : !pto.mask<b32>
// LOWER-NEXT: pto.vstsx2 %[[VAL_12]], %[[VAL_13]], %[[VAL_2]]{{\[}}%[[VAL_3]]], "INTLV_B32", %[[VAL_14]] : !pto.vreg<64xf32>, !pto.vreg<64xf32>, !pto.ptr<f32, ub>, index, !pto.mask<b32>
// LOWER-NEXT: return
// LOWER-NEXT: }
