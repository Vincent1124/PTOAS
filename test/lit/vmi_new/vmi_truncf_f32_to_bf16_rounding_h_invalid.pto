// RUN: not ptoas --emit-pto-ir %s 2>&1 | FileCheck %s

// Legacy truncf form of the f32 -> bf16 half-up rejection: the A5 F2F profile
// has no half-up form for the direct f32 -> bf16 pair (R/A/Z only).

// CHECK: error: 'pto.vmi.truncf' op rounding attr is not valid for this fp-to-fp conversion type pair

module {
  func.func @f32_to_bf16_half_up(%source: !pto.vmi.vreg<64xf32>) {
    %result = pto.vmi.truncf %source {rounding = "H", saturate = "SAT"}
        : !pto.vmi.vreg<64xf32> -> !pto.vmi.vreg<64xbf16>
    return
  }
}
