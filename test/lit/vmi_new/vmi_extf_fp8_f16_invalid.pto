// A hand-authored legacy extf cannot widen a float8 to f16/bf16: A5 vcvtff only
// widens 16-bit sources to f32 and float8 sources to f32.  The verifier rejects
// the pair and names the two-step form, so the failure happens at IR
// construction instead of in the LLVM emitter.
// RUN: not pto-test-opt %s 2>&1 | FileCheck %s

module {
  func.func @extf_f8e4m3_to_f16(
      %x: !pto.vmi.vreg<8xf8E4M3FN, #pto.vmi.layout<contiguous>>)
      -> !pto.vmi.vreg<8xf16, #pto.vmi.layout<contiguous>> {
    %r = pto.vmi.extf %x
        : !pto.vmi.vreg<8xf8E4M3FN, #pto.vmi.layout<contiguous>>
       -> !pto.vmi.vreg<8xf16, #pto.vmi.layout<contiguous>>
    return %r : !pto.vmi.vreg<8xf16, #pto.vmi.layout<contiguous>>
  }
}

// CHECK: error: 'pto.vmi.extf' op unsupported fp widening type pair on A5: 'f8E4M3FN' -> 'f16'

