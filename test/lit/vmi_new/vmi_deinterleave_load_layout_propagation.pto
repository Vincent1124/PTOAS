// ASSIGN-NEXT: %[[VAL_13:[a-zA-Z0-9_.$-]+]] = pto.vmi.mask_and %[[VAL_12]], %[[VAL_3]] : !pto.vmi.mask<256xb32, #pto.vmi.layout<contiguous>>, !pto.vmi.mask<256xb32, #pto.vmi.layout<contiguous>> -> !pto.vmi.mask<256xb32, #pto.vmi.layout<contiguous>>
// ASSIGN-NEXT: %[[VAL_14:[a-zA-Z0-9_.$-]+]] = pto.vmi.ensure_layout %[[VAL_9]] : !pto.vmi.vreg<256xui32, #pto.vmi.layout<contiguous>> -> !pto.vmi.vreg<256xui32, #pto.vmi.layout<deinterleaved = 2>>
// ASSIGN-NEXT: %[[VAL_15:[a-zA-Z0-9_.$-]+]] = pto.vmi.trunci %[[VAL_14]] {saturate = "SAT"} : !pto.vmi.vreg<256xui32, #pto.vmi.layout<deinterleaved = 2>> -> !pto.vmi.vreg<256xui8, #pto.vmi.layout<contiguous, lane_stride = 2>>
// ASSIGN-NEXT: %[[VAL_16:[a-zA-Z0-9_.$-]+]] = pto.vmi.ensure_mask_layout %[[VAL_13]] : !pto.vmi.mask<256xb32, #pto.vmi.layout<contiguous>> -> !pto.vmi.mask<256xb32, #pto.vmi.layout<deinterleaved = 4>>
// ASSIGN-NEXT: %[[VAL_17:[a-zA-Z0-9_.$-]+]] = pto.vmi.ensure_mask_granularity %[[VAL_16]] : !pto.vmi.mask<256xb32, #pto.vmi.layout<deinterleaved = 4>> -> !pto.vmi.mask<256xb8, #pto.vmi.layout<contiguous>>
// ASSIGN-NEXT: %[[VAL_18:[a-zA-Z0-9_.$-]+]] = pto.vmi.ensure_layout %[[VAL_15]] : !pto.vmi.vreg<256xui8, #pto.vmi.layout<contiguous, lane_stride = 2>> -> !pto.vmi.vreg<256xui8, #pto.vmi.layout<contiguous>>
// ASSIGN-NEXT: %[[VAL_19:[a-zA-Z0-9_.$-]+]] = pto.vmi.vdhist %[[VAL_2]], %[[VAL_18]], %[[VAL_17]] : !pto.vmi.vreg<256xui16, #pto.vmi.layout<contiguous>>, !pto.vmi.vreg<256xui8, #pto.vmi.layout<contiguous>>, !pto.vmi.mask<256xb8, #pto.vmi.layout<contiguous>> -> !pto.vmi.vreg<256xui16, #pto.vmi.layout<contiguous>>
