// ASSIGN-NEXT: %[[VAL_6:[a-zA-Z0-9_.$-]+]], %[[VAL_7:[a-zA-Z0-9_.$-]+]] = pto.vmi.deinterleave_load %[[VAL_0]]{{\[}}%[[VAL_4]]] : !pto.ptr<ui32, ub> -> !pto.vmi.vreg<256xui32, #pto.vmi.layout<contiguous>>, !pto.vmi.vreg<256xui32, #pto.vmi.layout<contiguous>>
