// RUN: pto-test-opt %s -vmi-lower-unified-to-legacy -vmi-mask-granularity-assignment -vmi-layout-assignment -vmi-to-vpto | FileCheck %s

// The op-level `precisionType` selector must survive the VMI -> VPTO lowering so
// the SoftLib expansion still sees the high-precision request; a default-precision
// division must not gain the attribute on the way down.

module {
  func.func @vmi_vdiv_precision_type(
      %lhs: !pto.vmi.vreg<64xf32>,
      %rhs: !pto.vmi.vreg<64xf32>,
      %mask: !pto.vmi.mask<64xpred>,
      %dst: !pto.ptr<f32, ub>,
      %off: index) {
    %c0 = arith.constant 0 : index
    %c8 = arith.constant 8 : i16
    %exact = pto.vmi.vdiv %lhs, %rhs, %mask {precisionType = #pto<div_precision precision_0ulp_ftz_true>}
        : !pto.vmi.vreg<64xf32>, !pto.vmi.vreg<64xf32>, !pto.vmi.mask<64xpred>
        -> !pto.vmi.vreg<64xf32>
    %plain = pto.vmi.vdiv %lhs, %rhs, %mask
        : !pto.vmi.vreg<64xf32>, !pto.vmi.vreg<64xf32>, !pto.vmi.mask<64xpred>
        -> !pto.vmi.vreg<64xf32>
    pto.vmi.vstore %exact, %dst[%off], %c8
        : !pto.vmi.vreg<64xf32>, !pto.ptr<f32, ub>
    pto.vmi.vstore %plain, %dst[%c0], %c8
        : !pto.vmi.vreg<64xf32>, !pto.ptr<f32, ub>
    return
  }
}

// CHECK-LABEL: func.func @vmi_vdiv_precision_type
// CHECK:      %[[EXACT:.*]] = pto.vdiv %{{.*}}, %{{.*}}, %{{.*}} {precisionType = #pto<div_precision precision_0ulp_ftz_true>}
// CHECK:      %[[PLAIN:.*]] = pto.vdiv %{{.*}}, %{{.*}}, %{{.*}} : !pto.vreg<64xf32>, !pto.vreg<64xf32>, !pto.mask<b32>
// CHECK-NOT:  pto.vmi.vdiv
// CHECK:      pto.vsstb %[[EXACT]]
// CHECK:      pto.vsstb %[[PLAIN]]
