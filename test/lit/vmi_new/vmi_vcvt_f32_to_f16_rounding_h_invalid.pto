// RUN: not ptoas --emit-pto-ir %s 2>&1 | FileCheck %s

// The A5 F2F profile has no half-up form for the direct f32 -> f16 pair, so
// the VMI contract (lookupVMIFpToFpContract) only allows R/A/Z there.  H must
// be rejected up front instead of failing in the backend selector.

// CHECK: error: 'pto.vmi.vcvt' op rounding is not valid for this fp-to-fp conversion type pair

module {
  func.func @f32_to_f16_half_up(%source: !pto.vmi.vreg<64xf32>) {
    %result = pto.vmi.vcvt %source {rounding = "H", saturate = "SAT"}
        : !pto.vmi.vreg<64xf32> -> !pto.vmi.vreg<64xf16>
    return
  }
}
