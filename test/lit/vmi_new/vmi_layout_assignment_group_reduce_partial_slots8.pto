// RUN: pto-test-opt %s -vmi-lower-unified-to-legacy -vmi-mask-granularity-assignment -vmi-layout-assignment | FileCheck %s

module {
  func.func @vmi_layout_assignment_group_reduce_f16_s64_g4(
      %source: !pto.vmi.vreg<256xf16>,
      %mask: !pto.vmi.mask<256xpred>)
      -> !pto.vmi.vreg<4xf16> {
    %out = pto.vmi.vcadd %source, %mask
        {group = 4, reassoc}
        : !pto.vmi.vreg<256xf16>, !pto.vmi.mask<256xpred>
        -> !pto.vmi.vreg<4xf16>
    return %out : !pto.vmi.vreg<4xf16>
  }

  func.func @vmi_layout_assignment_group_reduce_f16_s64_g12(
      %source: !pto.vmi.vreg<768xf16>,
      %mask: !pto.vmi.mask<768xpred>)
      -> !pto.vmi.vreg<12xf16> {
    %out = pto.vmi.vcadd %source, %mask
        {group = 12, reassoc}
        : !pto.vmi.vreg<768xf16>, !pto.vmi.mask<768xpred>
        -> !pto.vmi.vreg<12xf16>
    return %out : !pto.vmi.vreg<12xf16>
  }
}
// A 256-lane f16 value is only two physical parts, too short to rearrange into
// four deinterleaved groups, so the reduction keeps the contiguous source and
// carries one group per part.

// CHECK-LABEL: func.func @vmi_layout_assignment_group_reduce_f16_s64_g4(
// CHECK-SAME: %[[VAL_0:[a-zA-Z0-9_.$-]+]]: !pto.vmi.vreg<256xf16, #pto.vmi.layout<contiguous>>,
// CHECK-SAME: %[[VAL_1:[a-zA-Z0-9_.$-]+]]: !pto.vmi.mask<256xb32, #pto.vmi.layout<contiguous>>) -> !pto.vmi.vreg<4xf16, #pto.vmi.layout<num_groups = 4, slots = 1>> {
// CHECK-NEXT: %[[VAL_2:[a-zA-Z0-9_.$-]+]] = pto.vmi.ensure_mask_granularity %[[VAL_1]] : !pto.vmi.mask<256xb32, #pto.vmi.layout<contiguous>> -> !pto.vmi.mask<256xb16, #pto.vmi.layout<contiguous>>
// CHECK-NEXT: %[[VAL_3:[a-zA-Z0-9_.$-]+]] = pto.vmi.group_reduce_addf %[[VAL_0]], %[[VAL_2]] {num_groups = 4 : i64, reassoc} : !pto.vmi.vreg<256xf16, #pto.vmi.layout<contiguous>>, !pto.vmi.mask<256xb16, #pto.vmi.layout<contiguous>> -> !pto.vmi.vreg<4xf16, #pto.vmi.layout<num_groups = 4, slots = 1>>
// CHECK-NEXT: return %[[VAL_3]] : !pto.vmi.vreg<4xf16, #pto.vmi.layout<num_groups = 4, slots = 1>>
// CHECK-NEXT: }
// CHECK-LABEL: func.func @vmi_layout_assignment_group_reduce_f16_s64_g12(
// CHECK-SAME: %[[VAL_0:[a-zA-Z0-9_.$-]+]]: !pto.vmi.vreg<768xf16, #pto.vmi.layout<contiguous>>,
// CHECK-SAME: %[[VAL_1:[a-zA-Z0-9_.$-]+]]: !pto.vmi.mask<768xb32, #pto.vmi.layout<contiguous>>) -> !pto.vmi.vreg<12xf16, #pto.vmi.layout<num_groups = 12, slots = 1>> {
// CHECK-NEXT: %[[VAL_2:[a-zA-Z0-9_.$-]+]] = pto.vmi.ensure_mask_granularity %[[VAL_1]] : !pto.vmi.mask<768xb32, #pto.vmi.layout<contiguous>> -> !pto.vmi.mask<768xb16, #pto.vmi.layout<contiguous>>
// CHECK-NEXT: %[[VAL_3:[a-zA-Z0-9_.$-]+]] = pto.vmi.group_reduce_addf %[[VAL_0]], %[[VAL_2]] {num_groups = 12 : i64, reassoc} : !pto.vmi.vreg<768xf16, #pto.vmi.layout<contiguous>>, !pto.vmi.mask<768xb16, #pto.vmi.layout<contiguous>> -> !pto.vmi.vreg<12xf16, #pto.vmi.layout<num_groups = 12, slots = 1>>
// CHECK-NEXT: return %[[VAL_3]] : !pto.vmi.vreg<12xf16, #pto.vmi.layout<num_groups = 12, slots = 1>>
// CHECK-NEXT: }
