// RUN: pto-test-opt %s -vmi-lower-unified-to-legacy -vmi-mask-granularity-assignment -vmi-layout-assignment | FileCheck %s

// A width-changing cast whose sub-32-bit side carries elementwise compute keeps
// that side contiguous.  The lane-stride carrier is elementBits * laneStride
// wide, so it splits the 128-lane bf16 class over two physical parts and makes
// every sub-word op in the class - here the pto.vmi.vmax - two physical ops.
// The native {c(), d(f)} cast puts the wide side into the deinterleaved
// family and avoids the internal shuffle of same-layout BF16 widening.

module {
  func.func @narrow_side_compute_contiguous(
      %a: !pto.vmi.vreg<128xbf16>,
      %b: !pto.vmi.vreg<128xbf16>,
      %dst: !pto.ptr<f32, ub>,
      %off: index) {
    %c128 = arith.constant 128 : index
    %m = pto.vmi.create_mask %c128 : index -> !pto.vmi.mask<128xpred>
    %acc = pto.vmi.vmax %a, %b, %m
        : !pto.vmi.vreg<128xbf16>, !pto.vmi.vreg<128xbf16>, !pto.vmi.mask<128xpred>
       -> !pto.vmi.vreg<128xbf16>
    %wide = pto.vmi.vcvt %acc
        : !pto.vmi.vreg<128xbf16> -> !pto.vmi.vreg<128xf32>
    pto.vmi.vstore %wide, %dst[%off]
        : !pto.vmi.vreg<128xf32>, !pto.ptr<f32, ub>
    return
  }
}

// CHECK-LABEL: func.func @narrow_side_compute_contiguous(
// CHECK-SAME: %[[VAL_0:[a-zA-Z0-9_.$-]+]]: !pto.vmi.vreg<128xbf16, #pto.vmi.layout<contiguous>>,
// CHECK-SAME: %[[VAL_1:[a-zA-Z0-9_.$-]+]]: !pto.vmi.vreg<128xbf16, #pto.vmi.layout<contiguous>>,
// CHECK-SAME: %[[VAL_2:[a-zA-Z0-9_.$-]+]]: !pto.ptr<f32, ub>,
// CHECK-SAME: %[[VAL_3:[a-zA-Z0-9_.$-]+]]: index) {
// CHECK-NEXT: %[[VAL_4:[a-zA-Z0-9_.$-]+]] = arith.constant 128 : index
// CHECK-NEXT: %[[VAL_5:[a-zA-Z0-9_.$-]+]] = pto.vmi.create_mask %[[VAL_4]] : index -> !pto.vmi.mask<128xb32, #pto.vmi.layout<contiguous>>
// CHECK-NEXT: %[[VAL_6:[a-zA-Z0-9_.$-]+]] = pto.vmi.create_mask %[[VAL_4]] : index -> !pto.vmi.mask<128xb16, #pto.vmi.layout<contiguous>>
// CHECK-NEXT: %[[VAL_7:[a-zA-Z0-9_.$-]+]] = pto.vmi.vmax %[[VAL_0]], %[[VAL_1]], %[[VAL_6]] : !pto.vmi.vreg<128xbf16, #pto.vmi.layout<contiguous>>, !pto.vmi.vreg<128xbf16, #pto.vmi.layout<contiguous>>, !pto.vmi.mask<128xb16, #pto.vmi.layout<contiguous>> -> !pto.vmi.vreg<128xbf16, #pto.vmi.layout<contiguous>>
// CHECK-NEXT: %[[VAL_8:[a-zA-Z0-9_.$-]+]] = pto.vmi.extf %[[VAL_7]] : !pto.vmi.vreg<128xbf16, #pto.vmi.layout<contiguous>> -> !pto.vmi.vreg<128xf32, #pto.vmi.layout<contiguous>>
// CHECK-NEXT: pto.vmi.store %[[VAL_8]], %[[VAL_2]]{{\[}}%[[VAL_3]]] : !pto.vmi.vreg<128xf32, #pto.vmi.layout<contiguous>>, !pto.ptr<f32, ub>
// CHECK-NEXT: return
// CHECK-NEXT: }
