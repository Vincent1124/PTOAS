// RUN: pto-test-opt %s -vmi-lower-unified-to-legacy -vmi-mask-granularity-assignment -vmi-layout-assignment | FileCheck %s --check-prefix=ASSIGN
// RUN: pto-test-opt %s -vmi-lower-unified-to-legacy -vmi-mask-granularity-assignment -vmi-layout-assignment -vmi-to-vpto | FileCheck %s --check-prefix=LOWER

module {
  func.func @vmi_layout_assignment_group_load_s32_stride_broadcast_reduce(
      %base: !pto.ptr<f32, ub>,
      %mask: !pto.vmi.mask<256xpred>,
      %dst: !pto.ptr<f32, ub>,
      %off: index) {
    %c1 = arith.constant 1 : index
    %stride40 = arith.constant 40 : index
    %x = pto.vmi.vload %base[%off], %stride40 {group = 8}
        : !pto.ptr<f32, ub> -> !pto.vmi.vreg<256xf32>
    %sum = pto.vmi.vcadd %x, %mask
        {group = 8, reassoc}
        : !pto.vmi.vreg<256xf32>, !pto.vmi.mask<256xpred>
        -> !pto.vmi.vreg<8xf32>
    %b = pto.vmi.vbrc %sum {group = 8}
        : !pto.vmi.vreg<8xf32> -> !pto.vmi.vreg<256xf32>
    %y = pto.vmi.vmul %x, %b
        : !pto.vmi.vreg<256xf32>, !pto.vmi.vreg<256xf32>
        -> !pto.vmi.vreg<256xf32>
    %ysum = pto.vmi.vcadd %y, %mask
        {group = 8, reassoc}
        : !pto.vmi.vreg<256xf32>, !pto.vmi.mask<256xpred>
        -> !pto.vmi.vreg<8xf32>
    pto.vmi.vstore %ysum, %dst[%off], %c1 {group = 8}
        : !pto.vmi.vreg<8xf32>, !pto.ptr<f32, ub>
    return
  }
}

// LOWER-DAG: pto.pset_b32
// LOWER-DAG: pto.vsldb
// LOWER-DAG: pto.vadd
// LOWER-DAG: pto.vcgadd
// LOWER-DAG: pto.vstus
// LOWER-DAG: pto.vstas
// LOWER-NOT: VMI-RESIDUAL-OP
// LOWER-NOT: pto.vmi.

// ASSIGN-LABEL: func.func @vmi_layout_assignment_group_load_s32_stride_broadcast_reduce(
// ASSIGN-SAME: %[[VAL_0:[a-zA-Z0-9_.$-]+]]: !pto.ptr<f32, ub>,
// ASSIGN-SAME: %[[VAL_1:[a-zA-Z0-9_.$-]+]]: !pto.vmi.mask<256xb32, #pto.vmi.layout<contiguous>>,
// ASSIGN-SAME: %[[VAL_2:[a-zA-Z0-9_.$-]+]]: !pto.ptr<f32, ub>,
// ASSIGN-SAME: %[[VAL_3:[a-zA-Z0-9_.$-]+]]: index) {
// ASSIGN-NEXT: %[[VAL_4:[a-zA-Z0-9_.$-]+]] = arith.constant 1 : index
// ASSIGN-NEXT: %[[VAL_5:[a-zA-Z0-9_.$-]+]] = arith.constant 40 : index
// ASSIGN-NEXT: %[[VAL_6:[a-zA-Z0-9_.$-]+]] = pto.vmi.group_load %[[VAL_0]]{{\[}}%[[VAL_3]]], %[[VAL_5]] {num_groups = 8 : i64} : !pto.ptr<f32, ub> -> !pto.vmi.vreg<256xf32, #pto.vmi.layout<block_deinterleaved = 4>>
// ASSIGN-NEXT: %[[VAL_7:[a-zA-Z0-9_.$-]+]] = pto.vmi.ensure_mask_layout %[[VAL_1]] : !pto.vmi.mask<256xb32, #pto.vmi.layout<contiguous>> -> !pto.vmi.mask<256xb32, #pto.vmi.layout<block_deinterleaved = 4>>
// ASSIGN-NEXT: %[[VAL_8:[a-zA-Z0-9_.$-]+]] = pto.vmi.group_reduce_addf %[[VAL_6]], %[[VAL_7]] {num_groups = 8 : i64, reassoc} : !pto.vmi.vreg<256xf32, #pto.vmi.layout<block_deinterleaved = 4>>, !pto.vmi.mask<256xb32, #pto.vmi.layout<block_deinterleaved = 4>> -> !pto.vmi.vreg<8xf32, #pto.vmi.layout<num_groups = 8, slots = 8>>
// ASSIGN-NEXT: %[[VAL_9:[a-zA-Z0-9_.$-]+]] = pto.vmi.group_broadcast %[[VAL_8]] {num_groups = 8 : i64} : !pto.vmi.vreg<8xf32, #pto.vmi.layout<num_groups = 8, slots = 8>> -> !pto.vmi.vreg<256xf32, #pto.vmi.layout<block_deinterleaved = 4>>
// ASSIGN-NEXT: %[[VAL_10:[a-zA-Z0-9_.$-]+]] = pto.vmi.vmul %[[VAL_6]], %[[VAL_9]] : !pto.vmi.vreg<256xf32, #pto.vmi.layout<block_deinterleaved = 4>>, !pto.vmi.vreg<256xf32, #pto.vmi.layout<block_deinterleaved = 4>> -> !pto.vmi.vreg<256xf32, #pto.vmi.layout<block_deinterleaved = 4>>
// ASSIGN-NEXT: %[[VAL_11:[a-zA-Z0-9_.$-]+]] = pto.vmi.ensure_mask_layout %[[VAL_1]] : !pto.vmi.mask<256xb32, #pto.vmi.layout<contiguous>> -> !pto.vmi.mask<256xb32, #pto.vmi.layout<block_deinterleaved = 4>>
// ASSIGN-NEXT: %[[VAL_12:[a-zA-Z0-9_.$-]+]] = pto.vmi.group_reduce_addf %[[VAL_10]], %[[VAL_11]] {num_groups = 8 : i64, reassoc} : !pto.vmi.vreg<256xf32, #pto.vmi.layout<block_deinterleaved = 4>>, !pto.vmi.mask<256xb32, #pto.vmi.layout<block_deinterleaved = 4>> -> !pto.vmi.vreg<8xf32, #pto.vmi.layout<num_groups = 8, slots = 8>>
// ASSIGN-NEXT: pto.vmi.group_store %[[VAL_12]], %[[VAL_2]]{{\[}}%[[VAL_3]]], %[[VAL_4]] {num_groups = 8 : i64} : !pto.vmi.vreg<8xf32, #pto.vmi.layout<num_groups = 8, slots = 8>>, !pto.ptr<f32, ub>
// ASSIGN-NEXT: return
// ASSIGN-NEXT: }
