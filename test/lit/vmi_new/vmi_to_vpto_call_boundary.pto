// RUN: pto-test-opt %s -vmi-lower-unified-to-legacy -vmi-mask-granularity-assignment -vmi-layout-assignment -vmi-to-vpto | FileCheck %s

module {
  func.func private @callee(%x: !pto.vmi.vreg<128xf32>)
      -> !pto.vmi.vreg<128xf32> {
    %sum = pto.vmi.vadd %x, %x
        : !pto.vmi.vreg<128xf32>, !pto.vmi.vreg<128xf32>
        -> !pto.vmi.vreg<128xf32>
    return %sum : !pto.vmi.vreg<128xf32>
  }

  func.func @caller(%a: !pto.vmi.vreg<128xf16>)
      -> !pto.vmi.vreg<128xf32> {
    %ea = pto.vmi.vcvt %a
        : !pto.vmi.vreg<128xf16> -> !pto.vmi.vreg<128xf32>
    %r = call @callee(%ea)
        : (!pto.vmi.vreg<128xf32>) -> !pto.vmi.vreg<128xf32>
    %sum = pto.vmi.vadd %r, %r
        : !pto.vmi.vreg<128xf32>, !pto.vmi.vreg<128xf32>
        -> !pto.vmi.vreg<128xf32>
    return %sum : !pto.vmi.vreg<128xf32>
  }
}

// CHECK-LABEL: func.func private @callee(
// CHECK-SAME: %[[VAL_0:[a-zA-Z0-9_.$-]+]]: !pto.vreg<64xf32>,
// CHECK-SAME: %[[VAL_1:[a-zA-Z0-9_.$-]+]]: !pto.vreg<64xf32>) -> (!pto.vreg<64xf32>, !pto.vreg<64xf32>) {
// CHECK-NEXT: %[[VAL_2:[a-zA-Z0-9_.$-]+]] = pto.pset_b32 "PAT_ALL" : !pto.mask<b32>
// CHECK-NEXT: %[[VAL_3:[a-zA-Z0-9_.$-]+]] = pto.vadd %[[VAL_0]], %[[VAL_0]], %[[VAL_2]] : !pto.vreg<64xf32>, !pto.vreg<64xf32>, !pto.mask<b32> -> !pto.vreg<64xf32>
// CHECK-NEXT: %[[VAL_4:[a-zA-Z0-9_.$-]+]] = pto.pset_b32 "PAT_ALL" : !pto.mask<b32>
// CHECK-NEXT: %[[VAL_5:[a-zA-Z0-9_.$-]+]] = pto.vadd %[[VAL_1]], %[[VAL_1]], %[[VAL_4]] : !pto.vreg<64xf32>, !pto.vreg<64xf32>, !pto.mask<b32> -> !pto.vreg<64xf32>
// CHECK-NEXT: return %[[VAL_3]], %[[VAL_5]] : !pto.vreg<64xf32>, !pto.vreg<64xf32>
// CHECK-NEXT: }
// CHECK-LABEL: func.func @caller(
// CHECK-SAME: %[[VAL_0:[a-zA-Z0-9_.$-]+]]: !pto.vreg<128xf16>) -> (!pto.vreg<64xf32>, !pto.vreg<64xf32>) {
// CHECK-NEXT: %[[VAL_1:[a-zA-Z0-9_.$-]+]] = pto.pset_b16 "PAT_ALL" : !pto.mask<b16>
// CHECK-NEXT: %[[VAL_2:[a-zA-Z0-9_.$-]+]] = pto.vcvt %[[VAL_0]], %[[VAL_1]] {part = "EVEN"} : !pto.vreg<128xf16>, !pto.mask<b16> -> !pto.vreg<64xf32>
// CHECK-NEXT: %[[VAL_3:[a-zA-Z0-9_.$-]+]] = pto.vcvt %[[VAL_0]], %[[VAL_1]] {part = "ODD"} : !pto.vreg<128xf16>, !pto.mask<b16> -> !pto.vreg<64xf32>
// CHECK-NEXT: %[[VAL_4:[a-zA-Z0-9_.$-]+]], %[[VAL_5:[a-zA-Z0-9_.$-]+]] = pto.vintlv %[[VAL_2]], %[[VAL_3]] : !pto.vreg<64xf32>, !pto.vreg<64xf32> -> !pto.vreg<64xf32>, !pto.vreg<64xf32>
// CHECK-NEXT: %[[VAL_6:[a-zA-Z0-9_.$-]+]]:2 = call @callee(%[[VAL_4]], %[[VAL_5]]) : (!pto.vreg<64xf32>, !pto.vreg<64xf32>) -> (!pto.vreg<64xf32>, !pto.vreg<64xf32>)
// CHECK-NEXT: %[[VAL_7:[a-zA-Z0-9_.$-]+]] = pto.pset_b32 "PAT_ALL" : !pto.mask<b32>
// CHECK-NEXT: %[[VAL_8:[a-zA-Z0-9_.$-]+]] = pto.vadd %[[VAL_6]]#0, %[[VAL_6]]#0, %[[VAL_7]] : !pto.vreg<64xf32>, !pto.vreg<64xf32>, !pto.mask<b32> -> !pto.vreg<64xf32>
// CHECK-NEXT: %[[VAL_9:[a-zA-Z0-9_.$-]+]] = pto.pset_b32 "PAT_ALL" : !pto.mask<b32>
// CHECK-NEXT: %[[VAL_10:[a-zA-Z0-9_.$-]+]] = pto.vadd %[[VAL_6]]#1, %[[VAL_6]]#1, %[[VAL_9]] : !pto.vreg<64xf32>, !pto.vreg<64xf32>, !pto.mask<b32> -> !pto.vreg<64xf32>
// CHECK-NEXT: return %[[VAL_8]], %[[VAL_10]] : !pto.vreg<64xf32>, !pto.vreg<64xf32>
// CHECK-NEXT: }
