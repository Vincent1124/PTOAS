// ASSIGN-SAME: %[[VAL_0:[a-zA-Z0-9_.$-]+]]: !pto.vmi.vreg<256xsi16, #pto.vmi.layout<contiguous>>,
// ASSIGN-SAME: %[[VAL_1:[a-zA-Z0-9_.$-]+]]: !pto.vmi.mask<256xb32, #pto.vmi.layout<contiguous>>) -> !pto.vmi.vreg<8xsi32, #pto.vmi.layout<num_groups = 8, slots = 1>> {
// ASSIGN-NEXT: %[[VAL_2:[a-zA-Z0-9_.$-]+]] = pto.vmi.extsi %[[VAL_0]] : !pto.vmi.vreg<256xsi16, #pto.vmi.layout<contiguous>> -> !pto.vmi.vreg<256xsi32, #pto.vmi.layout<deinterleaved = 2>>
// ASSIGN-NEXT: %[[VAL_3:[a-zA-Z0-9_.$-]+]] = pto.vmi.ensure_layout %[[VAL_2]] : !pto.vmi.vreg<256xsi32, #pto.vmi.layout<deinterleaved = 2>> -> !pto.vmi.vreg<256xsi32, #pto.vmi.layout<contiguous>>
// ASSIGN-NEXT: %[[VAL_4:[a-zA-Z0-9_.$-]+]] = pto.vmi.group_reduce_addi %[[VAL_3]], %[[VAL_1]] {num_groups = 8 : i64, reassoc} : !pto.vmi.vreg<256xsi32, #pto.vmi.layout<contiguous>>, !pto.vmi.mask<256xb32, #pto.vmi.layout<contiguous>> -> !pto.vmi.vreg<8xsi32, #pto.vmi.layout<num_groups = 8, slots = 1>>
// ASSIGN-NEXT: return %[[VAL_4]] : !pto.vmi.vreg<8xsi32, #pto.vmi.layout<num_groups = 8, slots = 1>>
// ASSIGN-NEXT: }

