// RUN: pto-test-opt %s -vmi-lower-unified-to-legacy -vmi-mask-granularity-assignment -vmi-layout-assignment | FileCheck %s

module {
  func.func @typed_group_reduce_assignment(
      %f16: !pto.vmi.vreg<256xf16>,
      %mf16: !pto.vmi.mask<256xpred>,
      %i16: !pto.vmi.vreg<128xsi16>,
      %mi16: !pto.vmi.mask<128xpred>,
      %i32: !pto.vmi.vreg<128xi32>,
      %mi32: !pto.vmi.mask<128xpred>) {
    %sum_f16 = pto.vmi.vcadd %f16, %mf16 {group = 8, reassoc}
        : !pto.vmi.vreg<256xf16>, !pto.vmi.mask<256xpred>
        -> !pto.vmi.vreg<8xf16>
    %wide_i16 = pto.vmi.vcvt %i16
        : !pto.vmi.vreg<128xsi16> -> !pto.vmi.vreg<128xsi32>
    %sum_i16 = pto.vmi.vcadd %wide_i16, %mi16 {group = 8}
        : !pto.vmi.vreg<128xsi32>, !pto.vmi.mask<128xpred>
        -> !pto.vmi.vreg<8xsi32>
    %sum_i32 = pto.vmi.vcadd %i32, %mi32 {group = 8}
        : !pto.vmi.vreg<128xi32>, !pto.vmi.mask<128xpred>
        -> !pto.vmi.vreg<8xi32>
    return
  }
}

// CHECK-LABEL: func.func @typed_group_reduce_assignment(
// CHECK-SAME: %[[VAL_0:[a-zA-Z0-9_.$-]+]]: !pto.vmi.vreg<256xf16, #pto.vmi.layout<contiguous>>,
// CHECK-SAME: %[[VAL_1:[a-zA-Z0-9_.$-]+]]: !pto.vmi.mask<256xb32, #pto.vmi.layout<contiguous>>,
// CHECK-SAME: %[[VAL_2:[a-zA-Z0-9_.$-]+]]: !pto.vmi.vreg<128xsi16, #pto.vmi.layout<contiguous>>,
// CHECK-SAME: %[[VAL_3:[a-zA-Z0-9_.$-]+]]: !pto.vmi.mask<128xb32, #pto.vmi.layout<contiguous>>,
// CHECK-SAME: %[[VAL_4:[a-zA-Z0-9_.$-]+]]: !pto.vmi.vreg<128xi32, #pto.vmi.layout<contiguous>>,
// CHECK-SAME: %[[VAL_5:[a-zA-Z0-9_.$-]+]]: !pto.vmi.mask<128xb32, #pto.vmi.layout<contiguous>>) {
// CHECK-NEXT: %[[VAL_6:[a-zA-Z0-9_.$-]+]] = pto.vmi.ensure_mask_granularity %[[VAL_1]] : !pto.vmi.mask<256xb32, #pto.vmi.layout<contiguous>> -> !pto.vmi.mask<256xb16, #pto.vmi.layout<contiguous>>
// CHECK-NEXT: %[[VAL_7:[a-zA-Z0-9_.$-]+]] = pto.vmi.ensure_mask_layout %[[VAL_6]] : !pto.vmi.mask<256xb16, #pto.vmi.layout<contiguous>> -> !pto.vmi.mask<256xb16, #pto.vmi.layout<deinterleaved = 2>>
// CHECK-NEXT: %[[VAL_8:[a-zA-Z0-9_.$-]+]] = pto.vmi.ensure_layout %[[VAL_0]] : !pto.vmi.vreg<256xf16, #pto.vmi.layout<contiguous>> -> !pto.vmi.vreg<256xf16, #pto.vmi.layout<deinterleaved = 2>>
// CHECK-NEXT: %[[VAL_9:[a-zA-Z0-9_.$-]+]] = pto.vmi.group_reduce_addf %[[VAL_8]], %[[VAL_7]] {num_groups = 8 : i64, reassoc} : !pto.vmi.vreg<256xf16, #pto.vmi.layout<deinterleaved = 2>>, !pto.vmi.mask<256xb16, #pto.vmi.layout<deinterleaved = 2>> -> !pto.vmi.vreg<8xf16, #pto.vmi.layout<num_groups = 8, slots = 8>>
// CHECK-NEXT: %[[VAL_10:[a-zA-Z0-9_.$-]+]] = pto.vmi.extsi %[[VAL_2]] : !pto.vmi.vreg<128xsi16, #pto.vmi.layout<contiguous>> -> !pto.vmi.vreg<128xsi32, #pto.vmi.layout<deinterleaved = 2>>
// CHECK-NEXT: %[[VAL_11:[a-zA-Z0-9_.$-]+]] = pto.vmi.ensure_mask_layout %[[VAL_3]] : !pto.vmi.mask<128xb32, #pto.vmi.layout<contiguous>> -> !pto.vmi.mask<128xb32, #pto.vmi.layout<deinterleaved = 2>>
// CHECK-NEXT: %[[VAL_12:[a-zA-Z0-9_.$-]+]] = pto.vmi.group_reduce_addi %[[VAL_10]], %[[VAL_11]] {num_groups = 8 : i64} : !pto.vmi.vreg<128xsi32, #pto.vmi.layout<deinterleaved = 2>>, !pto.vmi.mask<128xb32, #pto.vmi.layout<deinterleaved = 2>> -> !pto.vmi.vreg<8xsi32, #pto.vmi.layout<num_groups = 8, slots = 8>>
// CHECK-NEXT: %[[VAL_13:[a-zA-Z0-9_.$-]+]] = pto.vmi.ensure_layout %[[VAL_4]] : !pto.vmi.vreg<128xi32, #pto.vmi.layout<contiguous>> -> !pto.vmi.vreg<128xi32, #pto.vmi.layout<deinterleaved = 2>>
// CHECK-NEXT: %[[VAL_14:[a-zA-Z0-9_.$-]+]] = pto.vmi.ensure_mask_layout %[[VAL_5]] : !pto.vmi.mask<128xb32, #pto.vmi.layout<contiguous>> -> !pto.vmi.mask<128xb32, #pto.vmi.layout<deinterleaved = 2>>
// CHECK-NEXT: %[[VAL_15:[a-zA-Z0-9_.$-]+]] = pto.vmi.group_reduce_addi %[[VAL_13]], %[[VAL_14]] {num_groups = 8 : i64} : !pto.vmi.vreg<128xi32, #pto.vmi.layout<deinterleaved = 2>>, !pto.vmi.mask<128xb32, #pto.vmi.layout<deinterleaved = 2>> -> !pto.vmi.vreg<8xi32, #pto.vmi.layout<num_groups = 8, slots = 8>>
// CHECK-NEXT: return
// CHECK-NEXT: }
