// EMITC: TDIV<pto::DivAlgorithm::HIGH_PRECISION>(
// EMITC-LABEL: tdivs_tile_scalar_arg(
// EMITC: TDIVS(
// EMITC-LABEL: tdivs_scalar_tile_arg(
// EMITC: TDIVS(
