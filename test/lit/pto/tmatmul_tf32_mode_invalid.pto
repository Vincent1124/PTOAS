// RUN: not ptoas --pto-arch=a5 %s -o - 2>&1 | FileCheck %s

// `tf32_mode` selects HF32 input rounding, which only exists for FP32 operands.
// Requesting it on a low-precision matmul must be rejected instead of being
// silently lowered to ordinary FP32.

!left = !pto.tile_buf<loc=left, dtype=f16, rows=32, cols=32, v_row=32, v_col=32, blayout=col_major, slayout=row_major, fractal=512, pad=0>
!right = !pto.tile_buf<loc=right, dtype=f16, rows=32, cols=32, v_row=32, v_col=32, blayout=row_major, slayout=col_major, fractal=512, pad=0>
!acc = !pto.tile_buf<loc=acc, dtype=f32, rows=32, cols=32, v_row=32, v_col=32, blayout=col_major, slayout=row_major, fractal=1024, pad=0>

module attributes {pto.target_arch = "a5"} {
  func.func private @tf32_on_f16(%a: !left, %b: !right, %c: !acc) {
    pto.tmatmul ins(%a, %b : !left, !right) outs(%c : !acc) {tf32_mode = #pto<tf32_mode round_away>}
    return
  }
}

// CHECK: expects f32 lhs/rhs and an f32 accumulator when tf32_mode is set
