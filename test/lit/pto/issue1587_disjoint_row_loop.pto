// RUN: ptoas --pto-arch=a3 --pto-level=level3 --enable-insert-sync --emit-pto-ir %s | FileCheck %s
// RUN: ptoas --pto-arch=a5 --pto-level=level3 --enable-insert-sync --emit-pto-ir %s | FileCheck %s

// Each iteration of the first three loops writes a distinct complete UB row.
// Removing their V <-> MTE2 backedges must preserve initialization and the
// final whole-parent store. Zero and one iterations exercise event boundaries.
// Constant, unknown, and modulo row offsets can reuse storage and retain sync.
// The per-row reader retains same-iteration RAW dependencies, without serializing
// the next distinct row. Moving parents, nested reuse, and whole-parent readers
// retain the dependencies that their aliasing requires.
!parent = !pto.tile_buf<vec, 64x512xbf16>
!row = !pto.tile_buf<vec, 1x512xbf16>
!src = !pto.partition_tensor_view<1x512xbf16>
!out = !pto.partition_tensor_view<64x512xbf16>

module {
  func.func @issue1587_disjoint_rows_64(%src: !src, %out: !out) attributes {pto.kernel_kind = #pto.kernel_kind<vector>} {
    %c0 = arith.constant 0 : index
    %c1 = arith.constant 1 : index
    %c2 = arith.constant 2 : index
    %c64 = arith.constant 64 : index
    %a0 = arith.constant 0 : i64
    %a65536 = arith.constant 65536 : i64
    %zero = arith.constant 0.0 : bf16
    %parent = pto.alloc_tile addr = %a0 : !parent
    %zero_row = pto.alloc_tile addr = %a65536 : !row
    pto.texpands ins(%zero : bf16) outs(%parent : !parent)
    pto.texpands ins(%zero : bf16) outs(%zero_row : !row)
    scf.for %r = %c0 to %c64 step %c1 {
      %target = pto.subview %parent[%r, %c0] sizes [1, 512] : !parent -> !row
      %parity = arith.remui %r, %c2 : index
      %take_dma = arith.cmpi eq, %parity, %c0 : index
      scf.if %take_dma {
        pto.tload ins(%src : !src) outs(%target : !row)
      } else {
        pto.tmov ins(%zero_row : !row) outs(%target : !row)
      }
    }
    pto.tstore ins(%parent : !parent) outs(%out : !out)
    return
  }

  func.func @issue1587_disjoint_rows_1(%src: !src, %out: !out) attributes {pto.kernel_kind = #pto.kernel_kind<vector>} {
    %c0 = arith.constant 0 : index
    %c1 = arith.constant 1 : index
    %c2 = arith.constant 2 : index
    %c64 = arith.constant 64 : index
    %a0 = arith.constant 0 : i64
    %a65536 = arith.constant 65536 : i64
    %zero = arith.constant 0.0 : bf16
    %parent = pto.alloc_tile addr = %a0 : !parent
    %zero_row = pto.alloc_tile addr = %a65536 : !row
    pto.texpands ins(%zero : bf16) outs(%parent : !parent)
    pto.texpands ins(%zero : bf16) outs(%zero_row : !row)
    scf.for %r = %c0 to %c1 step %c1 {
      %target = pto.subview %parent[%r, %c0] sizes [1, 512] : !parent -> !row
      %parity = arith.remui %r, %c2 : index
      %take_dma = arith.cmpi eq, %parity, %c0 : index
      scf.if %take_dma {
        pto.tload ins(%src : !src) outs(%target : !row)
      } else {
        pto.tmov ins(%zero_row : !row) outs(%target : !row)
      }
    }
    pto.tstore ins(%parent : !parent) outs(%out : !out)
    return
  }

  func.func @issue1587_disjoint_rows_0(%src: !src, %out: !out) attributes {pto.kernel_kind = #pto.kernel_kind<vector>} {
    %c0 = arith.constant 0 : index
    %c1 = arith.constant 1 : index
    %c2 = arith.constant 2 : index
    %c64 = arith.constant 64 : index
    %a0 = arith.constant 0 : i64
    %a65536 = arith.constant 65536 : i64
    %zero = arith.constant 0.0 : bf16
    %parent = pto.alloc_tile addr = %a0 : !parent
    %zero_row = pto.alloc_tile addr = %a65536 : !row
    pto.texpands ins(%zero : bf16) outs(%parent : !parent)
    pto.texpands ins(%zero : bf16) outs(%zero_row : !row)
    scf.for %r = %c0 to %c0 step %c1 {
      %target = pto.subview %parent[%r, %c0] sizes [1, 512] : !parent -> !row
      %parity = arith.remui %r, %c2 : index
      %take_dma = arith.cmpi eq, %parity, %c0 : index
      scf.if %take_dma {
        pto.tload ins(%src : !src) outs(%target : !row)
      } else {
        pto.tmov ins(%zero_row : !row) outs(%target : !row)
      }
    }
    pto.tstore ins(%parent : !parent) outs(%out : !out)
    return
  }

  func.func @issue1587_same_row_loop(%src: !src, %out: !out) attributes {pto.kernel_kind = #pto.kernel_kind<vector>} {
    %c0 = arith.constant 0 : index
    %c1 = arith.constant 1 : index
    %c2 = arith.constant 2 : index
    %c64 = arith.constant 64 : index
    %a0 = arith.constant 0 : i64
    %a65536 = arith.constant 65536 : i64
    %zero = arith.constant 0.0 : bf16
    %parent = pto.alloc_tile addr = %a0 : !parent
    %zero_row = pto.alloc_tile addr = %a65536 : !row
    pto.texpands ins(%zero : bf16) outs(%parent : !parent)
    pto.texpands ins(%zero : bf16) outs(%zero_row : !row)
    scf.for %r = %c0 to %c64 step %c1 {
      %target = pto.subview %parent[%c0, %c0] sizes [1, 512] : !parent -> !row
      %parity = arith.remui %r, %c2 : index
      %take_dma = arith.cmpi eq, %parity, %c0 : index
      scf.if %take_dma {
        pto.tload ins(%src : !src) outs(%target : !row)
      } else {
        pto.tmov ins(%zero_row : !row) outs(%target : !row)
      }
    }
    pto.tstore ins(%parent : !parent) outs(%out : !out)
    return
  }

  func.func @issue1587_unknown_row_loop(%unknown: index, %src: !src, %out: !out) attributes {pto.kernel_kind = #pto.kernel_kind<vector>} {
    %c0 = arith.constant 0 : index
    %c1 = arith.constant 1 : index
    %c2 = arith.constant 2 : index
    %c64 = arith.constant 64 : index
    %a0 = arith.constant 0 : i64
    %a65536 = arith.constant 65536 : i64
    %zero = arith.constant 0.0 : bf16
    %parent = pto.alloc_tile addr = %a0 : !parent
    %zero_row = pto.alloc_tile addr = %a65536 : !row
    pto.texpands ins(%zero : bf16) outs(%parent : !parent)
    pto.texpands ins(%zero : bf16) outs(%zero_row : !row)
    scf.for %r = %c0 to %c64 step %c1 {
      %target = pto.subview %parent[%unknown, %c0] sizes [1, 512] : !parent -> !row
      %parity = arith.remui %r, %c2 : index
      %take_dma = arith.cmpi eq, %parity, %c0 : index
      scf.if %take_dma {
        pto.tload ins(%src : !src) outs(%target : !row)
      } else {
        pto.tmov ins(%zero_row : !row) outs(%target : !row)
      }
    }
    pto.tstore ins(%parent : !parent) outs(%out : !out)
    return
  }

  func.func @issue1587_rotating_row_loop(%src: !src, %out: !out) attributes {pto.kernel_kind = #pto.kernel_kind<vector>} {
    %c0 = arith.constant 0 : index
    %c1 = arith.constant 1 : index
    %c2 = arith.constant 2 : index
    %c64 = arith.constant 64 : index
    %a0 = arith.constant 0 : i64
    %a65536 = arith.constant 65536 : i64
    %zero = arith.constant 0.0 : bf16
    %parent = pto.alloc_tile addr = %a0 : !parent
    %zero_row = pto.alloc_tile addr = %a65536 : !row
    pto.texpands ins(%zero : bf16) outs(%parent : !parent)
    pto.texpands ins(%zero : bf16) outs(%zero_row : !row)
    scf.for %r = %c0 to %c64 step %c1 {
      %slot = arith.remui %r, %c2 : index
      %target = pto.subview %parent[%slot, %c0] sizes [1, 512] : !parent -> !row
      %parity = arith.remui %r, %c2 : index
      %take_dma = arith.cmpi eq, %parity, %c0 : index
      scf.if %take_dma {
        pto.tload ins(%src : !src) outs(%target : !row)
      } else {
        pto.tmov ins(%zero_row : !row) outs(%target : !row)
      }
    }
    pto.tstore ins(%parent : !parent) outs(%out : !out)
    return
  }

  func.func @issue1587_disjoint_rows_reader(%src: !src, %out: !out, %row_out: !src) attributes {pto.kernel_kind = #pto.kernel_kind<vector>} {
    %c0 = arith.constant 0 : index
    %c1 = arith.constant 1 : index
    %c2 = arith.constant 2 : index
    %c64 = arith.constant 64 : index
    %a0 = arith.constant 0 : i64
    %a65536 = arith.constant 65536 : i64
    %zero = arith.constant 0.0 : bf16
    %parent = pto.alloc_tile addr = %a0 : !parent
    %zero_row = pto.alloc_tile addr = %a65536 : !row
    pto.texpands ins(%zero : bf16) outs(%parent : !parent)
    pto.texpands ins(%zero : bf16) outs(%zero_row : !row)
    scf.for %r = %c0 to %c64 step %c1 {
      %target = pto.subview %parent[%r, %c0] sizes [1, 512] : !parent -> !row
      %parity = arith.remui %r, %c2 : index
      %take_dma = arith.cmpi eq, %parity, %c0 : index
      scf.if %take_dma {
        pto.tload ins(%src : !src) outs(%target : !row)
      } else {
        pto.tmov ins(%zero_row : !row) outs(%target : !row)
      }
      pto.tstore ins(%target : !row) outs(%row_out : !src)
    }
    pto.tstore ins(%parent : !parent) outs(%out : !out)
    return
  }

  // The changing allocation cancels the subview offset: every iteration uses
  // address zero. An IV-shaped subview alone does not prove disjoint storage.
  func.func @issue1587_moving_parent_loop(%src: !src, %out: !out) attributes {pto.kernel_kind = #pto.kernel_kind<vector>} {
    %c0 = arith.constant 0 : index
    %c1 = arith.constant 1 : index
    %c2 = arith.constant 2 : index
    %c64 = arith.constant 64 : index
    %a0 = arith.constant 0 : i64
    %a1024 = arith.constant 1024 : i64
    %a65536 = arith.constant 65536 : i64
    %zero = arith.constant 0.0 : bf16
    %parent = pto.alloc_tile addr = %a0 : !parent
    %zero_row = pto.alloc_tile addr = %a65536 : !row
    pto.texpands ins(%zero : bf16) outs(%parent : !parent)
    pto.texpands ins(%zero : bf16) outs(%zero_row : !row)
    scf.for %r = %c0 to %c64 step %c1 {
      %r64 = arith.index_cast %r : index to i64
      %bytes = arith.muli %r64, %a1024 : i64
      %base = arith.subi %a0, %bytes : i64
      %moving_parent = pto.alloc_tile addr = %base : !parent
      %target = pto.subview %moving_parent[%r, %c0] sizes [1, 512] : !parent -> !row
      %parity = arith.remui %r, %c2 : index
      %take_dma = arith.cmpi eq, %parity, %c0 : index
      scf.if %take_dma {
        pto.tload ins(%src : !src) outs(%target : !row)
      } else {
        pto.tmov ins(%zero_row : !row) outs(%target : !row)
      }
    }
    pto.tstore ins(%parent : !parent) outs(%out : !out)
    return
  }

  // The outer row is invariant in the inner loop, which overwrites it twice.
  func.func @issue1587_nested_row_loop(%src: !src, %out: !out) attributes {pto.kernel_kind = #pto.kernel_kind<vector>} {
    %c0 = arith.constant 0 : index
    %c1 = arith.constant 1 : index
    %c2 = arith.constant 2 : index
    %c64 = arith.constant 64 : index
    %a0 = arith.constant 0 : i64
    %a65536 = arith.constant 65536 : i64
    %zero = arith.constant 0.0 : bf16
    %parent = pto.alloc_tile addr = %a0 : !parent
    %zero_row = pto.alloc_tile addr = %a65536 : !row
    pto.texpands ins(%zero : bf16) outs(%parent : !parent)
    pto.texpands ins(%zero : bf16) outs(%zero_row : !row)
    scf.for %r = %c0 to %c64 step %c1 {
      %target = pto.subview %parent[%r, %c0] sizes [1, 512] : !parent -> !row
      scf.for %repeat = %c0 to %c2 step %c1 {
        %take_dma = arith.cmpi eq, %repeat, %c0 : index
        scf.if %take_dma {
          pto.tload ins(%src : !src) outs(%target : !row)
        } else {
          pto.tmov ins(%zero_row : !row) outs(%target : !row)
        }
      }
    }
    pto.tstore ins(%parent : !parent) outs(%out : !out)
    return
  }

  // Reading the whole parent observes rows written by every iteration.
  func.func @issue1587_whole_parent_reader(%src: !src, %out: !out) attributes {pto.kernel_kind = #pto.kernel_kind<vector>} {
    %c0 = arith.constant 0 : index
    %c1 = arith.constant 1 : index
    %c2 = arith.constant 2 : index
    %c64 = arith.constant 64 : index
    %a0 = arith.constant 0 : i64
    %a65536 = arith.constant 65536 : i64
    %zero = arith.constant 0.0 : bf16
    %parent = pto.alloc_tile addr = %a0 : !parent
    %zero_row = pto.alloc_tile addr = %a65536 : !row
    pto.texpands ins(%zero : bf16) outs(%parent : !parent)
    pto.texpands ins(%zero : bf16) outs(%zero_row : !row)
    scf.for %r = %c0 to %c64 step %c1 {
      %target = pto.subview %parent[%r, %c0] sizes [1, 512] : !parent -> !row
      %parity = arith.remui %r, %c2 : index
      %take_dma = arith.cmpi eq, %parity, %c0 : index
      scf.if %take_dma {
        pto.tload ins(%src : !src) outs(%target : !row)
      } else {
        pto.tmov ins(%zero_row : !row) outs(%target : !row)
      }
      pto.tstore ins(%parent : !parent) outs(%out : !out)
    }
    return
  }
  // Bitcasts and reshapes preserve the complete byte extent of each row.
  func.func @issue1587_disjoint_rows_aliases(%src: !src, %out: !out) attributes {pto.kernel_kind = #pto.kernel_kind<vector>} {
    %c0 = arith.constant 0 : index
    %c1 = arith.constant 1 : index
    %c2 = arith.constant 2 : index
    %c64 = arith.constant 64 : index
    %a0 = arith.constant 0 : i64
    %a65536 = arith.constant 65536 : i64
    %zero = arith.constant 0.0 : bf16
    %parent = pto.alloc_tile addr = %a0 : !parent
    %zero_row = pto.alloc_tile addr = %a65536 : !row
    %zero_bits = pto.bitcast %zero_row : !row -> !pto.tile_buf<vec, 1x512xi16>
    %zero_alias = pto.treshape %zero_bits : !pto.tile_buf<vec, 1x512xi16> -> !pto.tile_buf<vec, 2x256xi16>
    pto.texpands ins(%zero : bf16) outs(%parent : !parent)
    pto.texpands ins(%zero : bf16) outs(%zero_row : !row)
    scf.for %r = %c0 to %c64 step %c1 {
      %target = pto.subview %parent[%r, %c0] sizes [1, 512] : !parent -> !row
      %target_bits = pto.bitcast %target : !row -> !pto.tile_buf<vec, 1x512xi16>
      %target_alias = pto.treshape %target_bits : !pto.tile_buf<vec, 1x512xi16> -> !pto.tile_buf<vec, 2x256xi16>
      %parity = arith.remui %r, %c2 : index
      %take_dma = arith.cmpi eq, %parity, %c0 : index
      scf.if %take_dma {
        pto.tload ins(%src : !src) outs(%target : !row)
      } else {
        pto.tmov ins(%zero_alias : !pto.tile_buf<vec, 2x256xi16>) outs(%target_alias : !pto.tile_buf<vec, 2x256xi16>)
      }
    }
    pto.tstore ins(%parent : !parent) outs(%out : !out)
    return
  }
  // Inner iterations are disjoint, but the outer loop repeats the entire pass.
  func.func @issue1587_repeated_row_scan(%src: !src, %out: !out) attributes {pto.kernel_kind = #pto.kernel_kind<vector>} {
    %c0 = arith.constant 0 : index
    %c1 = arith.constant 1 : index
    %c2 = arith.constant 2 : index
    %c64 = arith.constant 64 : index
    %a0 = arith.constant 0 : i64
    %a65536 = arith.constant 65536 : i64
    %zero = arith.constant 0.0 : bf16
    %parent = pto.alloc_tile addr = %a0 : !parent
    %zero_row = pto.alloc_tile addr = %a65536 : !row
    pto.texpands ins(%zero : bf16) outs(%parent : !parent)
    pto.texpands ins(%zero : bf16) outs(%zero_row : !row)
    scf.for %repeat = %c0 to %c2 step %c1 {
      scf.for %r = %c0 to %c64 step %c1 {
        %target = pto.subview %parent[%r, %c0] sizes [1, 512] : !parent -> !row
        %take_dma = arith.cmpi eq, %repeat, %c0 : index
        scf.if %take_dma {
          pto.tload ins(%src : !src) outs(%target : !row)
        } else {
          pto.tmov ins(%zero_row : !row) outs(%target : !row)
        }
      }
    }
    pto.tstore ins(%parent : !parent) outs(%out : !out)
    return
  }
}

