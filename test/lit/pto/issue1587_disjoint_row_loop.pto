// CHECK: pto.texpands
// CHECK-NEXT: pto.wait_flag[<PIPE_V>, <PIPE_MTE2>, <[[DISJOINT_ROWS_64_INIT]]>]
// CHECK-NEXT: scf.for
// CHECK-NOT: pto.{{(set|wait)}}_flag
// CHECK: scf.if
// CHECK-NEXT: pto.tload
// CHECK-NEXT: } else {
// CHECK: pto.tmov
// CHECK-NEXT: }
// CHECK-NOT: pto.{{(set|wait)}}_flag
// CHECK: pto.set_flag[<PIPE_V>, <PIPE_MTE3>, <[[DISJOINT_ROWS_64_V_STORE:EVENT_ID[0-9]+]]>]
