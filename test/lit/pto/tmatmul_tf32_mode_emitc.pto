// RUN: ptoas --pto-arch=a5 %s 2>&1 | FileCheck %s --check-prefix=A5

// Per-operation HF32 selection on FP32 tile matmul: the EmitC backend must wrap
// the TMATMUL* call in a CTRL scope that enables HF32 (CTRL[46]) with the
// requested rounding mode (CTRL[47]) and restores the entry CTRL value
// afterwards, so the mode cannot leak into later ordinary FP32 matmuls.

!left = !pto.tile_buf<loc=left, dtype=f32, rows=32, cols=32, v_row=32, v_col=32, blayout=col_major, slayout=row_major, fractal=512, pad=0>
!right = !pto.tile_buf<loc=right, dtype=f32, rows=32, cols=32, v_row=32, v_col=32, blayout=row_major, slayout=col_major, fractal=512, pad=0>
!acc = !pto.tile_buf<loc=acc, dtype=f32, rows=32, cols=32, v_row=32, v_col=32, blayout=col_major, slayout=row_major, fractal=1024, pad=0>
!bias = !pto.tile_buf<loc=bias, dtype=f32, rows=1, cols=32, v_row=1, v_col=32, blayout=row_major, slayout=none_box, fractal=512, pad=0>

module attributes {pto.target_arch = "a5"} {
  // No tf32_mode: ordinary FP32, no CTRL traffic at all.
  func.func private @tf32_default(%a: !left, %b: !right, %c: !acc) {
    pto.tmatmul ins(%a, %b : !left, !right) outs(%c : !acc)
    return
  }

  func.func private @tf32_round_even(%a: !left, %b: !right, %c: !acc) {
    pto.tmatmul ins(%a, %b : !left, !right) outs(%c : !acc) {tf32_mode = #pto<tf32_mode round_even>}
    return
  }

  func.func private @tf32_round_away(%a: !left, %b: !right, %c: !acc) {
    pto.tmatmul ins(%a, %b : !left, !right) outs(%c : !acc) {tf32_mode = #pto<tf32_mode round_away>}
    return
  }

  func.func private @tf32_acc_round_away(%c: !acc, %a: !left, %b: !right) {
    pto.tmatmul.acc ins(%c, %a, %b : !acc, !left, !right) outs(%c : !acc) {tf32_mode = #pto<tf32_mode round_away>}
    return
  }

  func.func private @tf32_bias_round_even(%a: !left, %b: !right, %z: !bias, %c: !acc) {
    pto.tmatmul.bias ins(%a, %b, %z : !left, !right, !bias) outs(%c : !acc) {tf32_mode = #pto<tf32_mode round_even>}
    return
  }
}

// A5-LABEL: static AICORE void tf32_default(
// A5:      TMATMUL({{.*}});
// A5:      static AICORE void tf32_round_even(
// A5:      uint64_t {{__pto_saved_ctrl_[0-9]+}} = get_ctrl();
// A5:      set_ctrl(sbitset0(sbitset1({{__pto_saved_ctrl_[0-9]+}}, 46), 47));
// A5:      TMATMUL({{.*}});
// A5:      set_ctrl({{__pto_saved_ctrl_[0-9]+}});
// A5:      static AICORE void tf32_round_away(
// A5:      uint64_t {{__pto_saved_ctrl_[0-9]+}} = get_ctrl();
// A5:      set_ctrl(sbitset1(sbitset1({{__pto_saved_ctrl_[0-9]+}}, 46), 47));
// A5:      TMATMUL({{.*}});
// A5:      set_ctrl({{__pto_saved_ctrl_[0-9]+}});
// A5:      static AICORE void tf32_acc_round_away(
// A5:      set_ctrl(sbitset1(sbitset1({{__pto_saved_ctrl_[0-9]+}}, 46), 47));
// A5:      TMATMUL_ACC({{.*}});
// A5:      static AICORE void tf32_bias_round_even(
// A5:      set_ctrl(sbitset0(sbitset1({{__pto_saved_ctrl_[0-9]+}}, 46), 47));
// A5:      TMATMUL_BIAS({{.*}});
