// RUN: pto-test-opt %s -vmi-to-vpto | FileCheck %s

module {
  func.func @reduce_d4(%src: !pto.vmi.vreg<256xf32, #pto.vmi.layout<deinterleaved = 4>>,
                      %mask: !pto.vmi.mask<256xb32, #pto.vmi.layout<deinterleaved = 4>>)
      -> !pto.vmi.vreg<1xf32, #pto.vmi.layout<num_groups = 1, slots = 1>> {
    %sum = pto.vmi.group_reduce_addf %src, %mask {num_groups = 1, reassoc}
        : !pto.vmi.vreg<256xf32, #pto.vmi.layout<deinterleaved = 4>>,
          !pto.vmi.mask<256xb32, #pto.vmi.layout<deinterleaved = 4>>
        -> !pto.vmi.vreg<1xf32, #pto.vmi.layout<num_groups = 1, slots = 1>>
    return %sum : !pto.vmi.vreg<1xf32, #pto.vmi.layout<num_groups = 1, slots = 1>>
  }
}

// CHECK-LABEL: func.func @reduce_d4(
// CHECK: pto.vcadd
// CHECK: pto.vcadd
// CHECK: pto.vadd
// CHECK: pto.vcadd
// CHECK: pto.vadd
// CHECK: pto.vcadd
// CHECK: pto.vadd
// CHECK-NOT: pto.vmi.
// CHECK-NOT: unrealized_conversion_cast
