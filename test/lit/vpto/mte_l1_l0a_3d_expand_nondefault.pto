// RUN: ptoas --pto-arch=a5 --pto-backend=vpto --emit-vpto \
// RUN:   --mlir-print-ir-after=vpto-expand-wrapper-ops %s -o /dev/null 2>&1 \
// RUN:   | FileCheck %s

module attributes {pto.target_arch = "a5", pto.kernel_kind = #pto.kernel_kind<cube>} {
  func.func @mte_l1_l0a_3d_expand_nondefault(
      %src: !pto.ptr<f16, l1>, %dst: !pto.ptr<f16, l0a>) attributes {pto.kernel} {
    %c0 = arith.constant 0 : i64
    %c1 = arith.constant 1 : i64
    %c2 = arith.constant 2 : i64
    %c3 = arith.constant 3 : i64
    %c5 = arith.constant 5 : i64
    %c7 = arith.constant 7 : i64
    %c8 = arith.constant 8 : i64
    %c9 = arith.constant 9 : i64
    %c16 = arith.constant 16 : i64
    pto.mte_l1_l0a_3d %src, %dst, %c7, %c9, %c2, %c3, %c8, %c2, %c2, %c2, %c1, %c1, %c0, %c2, %c1, %c0, %c0, %c1, %c1, %c3, %c16, %c5
      {transpose = true}
      : !pto.ptr<f16, l1>, !pto.ptr<f16, l0a>
    return
  }
}

// CHECK-LABEL: func.func @mte_l1_l0a_3d_expand_nondefault(
// CHECK: arith.constant 282583078731785 : i64
// CHECK-NEXT: arith.constant 844446421811216 : i64
// CHECK: pto.set_l3d_fmatrix %{{.*}}
// CHECK-NEXT: pto.set_padding %{{.*}}
// CHECK-NEXT: pto.set_l3d_rpt %{{.*}}
// CHECK-NEXT: pto.load_l1_to_l0a_3d %{{.*}}, %{{.*}}, %{{.*}}, %{{.*}}, %{{.*}}, %{{.*}}, %{{.*}}, %{{.*}}, %{{.*}}, %{{.*}}, %{{.*}}, %{{.*}}, %{{.*}} {element_type = f16, transpose = true} : !pto.ptr<f16, l1>, !pto.ptr<f16, l0a>
