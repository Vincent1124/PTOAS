// RUN: pto-test-opt %s -vmi-layout-assignment | FileCheck %s --check-prefix=ASSIGN --implicit-check-not=pto.vmi.ensure_layout
// RUN: pto-test-opt %s -vmi-layout-assignment -vmi-to-vpto | FileCheck %s --check-prefix=LOWER --implicit-check-not=pto.vmi. --implicit-check-not=pto.vintlv --implicit-check-not=pto.vdintlv

// Same-width numeric casts preserve dense layouts. An explicit result must
// seed the matching source candidate even when the source is unassigned.
// ASSIGN-LABEL: func.func @fptosi_d2(
// ASSIGN: %[[X:.*]] = pto.vmi.load{{.*}} -> !pto.vmi.vreg<128xf32, #pto.vmi.layout<deinterleaved = 2>>
// ASSIGN-NEXT: %[[Y:.*]] = pto.vmi.fptosi %[[X]] {saturate = "SAT"} : !pto.vmi.vreg<128xf32, #pto.vmi.layout<deinterleaved = 2>> -> !pto.vmi.vreg<128xsi32, #pto.vmi.layout<deinterleaved = 2>>
// ASSIGN-NEXT: pto.vmi.store %[[Y]],
// LOWER-LABEL: func.func @fptosi_d2(
// LOWER: %[[X0:.*]], %[[X1:.*]] = pto.vldsx2{{.*}} "DINTLV_B32"
// LOWER: %[[Y0:.*]] = pto.vcvt %[[X0]], {{.*}} {rnd = "R", sat = "SAT"}
// LOWER: %[[Y1:.*]] = pto.vcvt %[[X1]], {{.*}} {rnd = "R", sat = "SAT"}
// LOWER: pto.vstsx2 %[[Y0]], %[[Y1]], {{.*}} "INTLV_B32"
module {
  func.func @fptosi_d2(%src: !pto.ptr<f32, ub>, %dst: !pto.ptr<si32, ub>) {
    %c0 = arith.constant 0 : index
    %x = pto.vmi.load %src[%c0] : !pto.ptr<f32, ub> -> !pto.vmi.vreg<128xf32>
    %y = pto.vmi.fptosi %x {saturate = "SAT"} : !pto.vmi.vreg<128xf32> -> !pto.vmi.vreg<128xsi32, #pto.vmi.layout<deinterleaved = 2>>
    pto.vmi.store %y, %dst[%c0] : !pto.vmi.vreg<128xsi32, #pto.vmi.layout<deinterleaved = 2>>, !pto.ptr<si32, ub>
    return
  }
}

// ASSIGN-LABEL: func.func @fptosi_d4(
// ASSIGN: %[[X:.*]] = pto.vmi.broadcast{{.*}} -> !pto.vmi.vreg<256xf32, #pto.vmi.layout<deinterleaved = 4>>
// ASSIGN-NEXT: %[[Y:.*]] = pto.vmi.fptosi %[[X]] {saturate = "SAT"} : !pto.vmi.vreg<256xf32, #pto.vmi.layout<deinterleaved = 4>> -> !pto.vmi.vreg<256xsi32, #pto.vmi.layout<deinterleaved = 4>>
// ASSIGN-NEXT: return %[[Y]]
// LOWER-LABEL: func.func @fptosi_d4(
// LOWER-COUNT-4: pto.vdup
// LOWER-COUNT-4: pto.vcvt{{.*}} {rnd = "R", sat = "SAT"}
// LOWER: return {{.*}} : !pto.vreg<64xsi32>, !pto.vreg<64xsi32>, !pto.vreg<64xsi32>, !pto.vreg<64xsi32>
module {
  func.func @fptosi_d4(%value: f32) -> !pto.vmi.vreg<256xsi32, #pto.vmi.layout<deinterleaved = 4>> {
    %x = pto.vmi.broadcast %value : f32 -> !pto.vmi.vreg<256xf32>
    %y = pto.vmi.fptosi %x {saturate = "SAT"} : !pto.vmi.vreg<256xf32> -> !pto.vmi.vreg<256xsi32, #pto.vmi.layout<deinterleaved = 4>>
    return %y : !pto.vmi.vreg<256xsi32, #pto.vmi.layout<deinterleaved = 4>>
  }
}

// All ports are unassigned. The component's dense memory candidates should
// flow through the cast without a standalone conversion before the add.
// ASSIGN-LABEL: func.func @sitofp_component_d2(
// ASSIGN: %[[X:.*]] = pto.vmi.load{{.*}} -> !pto.vmi.vreg<128xsi32, #pto.vmi.layout<deinterleaved = 2>>
// ASSIGN-NEXT: %[[Y:.*]] = pto.vmi.sitofp %[[X]] : !pto.vmi.vreg<128xsi32, #pto.vmi.layout<deinterleaved = 2>> -> !pto.vmi.vreg<128xf32, #pto.vmi.layout<deinterleaved = 2>>
// ASSIGN: pto.vmi.vadd %[[Y]],
// LOWER-LABEL: func.func @sitofp_component_d2(
// LOWER: pto.vldsx2{{.*}} "DINTLV_B32"
// LOWER-COUNT-2: pto.vcvt{{.*}} {rnd = "R"}
// LOWER-COUNT-2: pto.vadd
// LOWER: pto.vstsx2{{.*}} "INTLV_B32"
module {
  func.func @sitofp_component_d2(%src: !pto.ptr<si32, ub>, %dst: !pto.ptr<f32, ub>, %value: f32) {
    %c0 = arith.constant 0 : index
    %x = pto.vmi.load %src[%c0] : !pto.ptr<si32, ub> -> !pto.vmi.vreg<128xsi32>
    %y = pto.vmi.sitofp %x : !pto.vmi.vreg<128xsi32> -> !pto.vmi.vreg<128xf32>
    %other = pto.vmi.broadcast %value : f32 -> !pto.vmi.vreg<128xf32>
    %sum = pto.vmi.vadd %y, %other : !pto.vmi.vreg<128xf32>, !pto.vmi.vreg<128xf32> -> !pto.vmi.vreg<128xf32>
    pto.vmi.store %sum, %dst[%c0] : !pto.vmi.vreg<128xf32>, !pto.ptr<f32, ub>
    return
  }
}
