    %c3 = arith.constant 3 : i64
    %c4 = arith.constant 4 : i64
    %c8 = arith.constant 8 : i64
    %c10 = arith.constant 10 : i64
    %c16 = arith.constant 16 : i64
    pto.mte_l1_l0a_3d %src, %dst, %c10, %c10, %c3, %c3, %c16, %c1, %c1, %c1, %c1, %c0, %c0, %c0, %c0, %c0, %c0, %c2, %c0, %c0, %c8, %c4
      : !pto.ptr<f16, mat>, !pto.ptr<f16, left>
    return
  }
}

