// CHECK: 'pto.mte_l1_l0a_3d' op requires source and destination element types to match

// -----

module {
  func.func @load_l1_to_l0a_3d_rejects_mismatched_element_metadata(
      %src: !pto.ptr<f16, mat>, %dst: !pto.ptr<f16, left>) {
    %c0 = arith.constant 0 : i64
    %c1 = arith.constant 1 : i64
    %c3 = arith.constant 3 : i64
    %c16 = arith.constant 16 : i64
    pto.load_l1_to_l0a_3d %src, %dst, %c0, %c0, %c1, %c16, %c1, %c1, %c3, %c3, %c1, %c1, %c16
      {element_type = bf16}
      : !pto.ptr<f16, mat>, !pto.ptr<f16, left>
    return
  }
}

// CHECK: 'pto.load_l1_to_l0a_3d' op requires element_type to match source and destination element type

// -----

module {
  func.func @mte_l1_l0a_3d_rejects_derived_m_extent_overflow(
      %src: !pto.ptr<f16, mat>, %dst: !pto.ptr<f16, left>) {
    %c0 = arith.constant 0 : i64
    %c1 = arith.constant 1 : i64
    %c256 = arith.constant 256 : i64
    pto.mte_l1_l0a_3d %src, %dst, %c256, %c256, %c1, %c1, %c1, %c1, %c1, %c1, %c1, %c0, %c0, %c0, %c0, %c0, %c0, %c1, %c0, %c0
      : !pto.ptr<f16, mat>, !pto.ptr<f16, left>
    return
  }
}

// CHECK: 'pto.mte_l1_l0a_3d' op derived M extent must be < 2^15, got 65536

// -----

module {
  func.func @mte_l1_l0a_3d_rejects_derived_k_step_overflow(
      %src: !pto.ptr<f16, mat>, %dst: !pto.ptr<f16, left>) {
    %c0 = arith.constant 0 : i64
    %c1 = arith.constant 1 : i64
    %c4 = arith.constant 4 : i64
    %c16384 = arith.constant 16384 : i64
    pto.mte_l1_l0a_3d %src, %dst, %c4, %c4, %c4, %c4, %c16384, %c1, %c1, %c1, %c1, %c0, %c0, %c0, %c0, %c0, %c0, %c1, %c0, %c0
      : !pto.ptr<f16, mat>, !pto.ptr<f16, left>
    return
  }
}

