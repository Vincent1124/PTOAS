// CHECK: 'pto.mte_l1_l0a_3d' op k_start must be zero: split-K is not supported by the 3D load lowering, got k_start=8

// -----

module {
  func.func @mte_l1_l0a_3d_rejects_filter_footprint(
      %src: !pto.ptr<f16, mat>, %dst: !pto.ptr<f16, left>) {
    %c0 = arith.constant 0 : i64
    %c1 = arith.constant 1 : i64
    %c511 = arith.constant 511 : i64
    pto.mte_l1_l0a_3d %src, %dst, %c511, %c511, %c511, %c511, %c1, %c1, %c1, %c1, %c1, %c0, %c0, %c0, %c0, %c0, %c0, %c1, %c0, %c0
      : !pto.ptr<f16, mat>, !pto.ptr<f16, left>
    return
  }
}

// CHECK: 'pto.mte_l1_l0a_3d' op filter footprint must be < 2^16 elements, got 261121

// -----

module {
  func.func @mte_l1_l0a_3d_rejects_l1_capacity(
      %src: !pto.ptr<f16, mat>, %dst: !pto.ptr<f16, left>) {
    %c0 = arith.constant 0 : i64
    %c1 = arith.constant 1 : i64
    %c32 = arith.constant 32 : i64
    %c512 = arith.constant 512 : i64
    pto.mte_l1_l0a_3d %src, %dst, %c512, %c512, %c1, %c1, %c32, %c1, %c1, %c1, %c1, %c0, %c0, %c0, %c0, %c0, %c0, %c1, %c0, %c0
      : !pto.ptr<f16, mat>, !pto.ptr<f16, left>
    return
  }
}

// CHECK: 'pto.mte_l1_l0a_3d' op source feature map exceeds the L1 capacity: 16777216 bytes > 524288

// -----

module {
  func.func @mte_l1_l0a_3d_rejects_zero_stride(
      %src: !pto.ptr<f16, mat>, %dst: !pto.ptr<f16, left>) {
    %c0 = arith.constant 0 : i64
    %c1 = arith.constant 1 : i64
    %c3 = arith.constant 3 : i64
    %c8 = arith.constant 8 : i64
    %c16 = arith.constant 16 : i64
    pto.mte_l1_l0a_3d %src, %dst, %c8, %c8, %c3, %c3, %c16, %c0, %c1, %c1, %c1, %c0, %c0, %c0, %c0, %c0, %c0, %c1, %c0, %c0
      : !pto.ptr<f16, mat>, !pto.ptr<f16, left>
    return
  }
}

// CHECK: 'pto.mte_l1_l0a_3d' op stride_h must be greater than zero

// -----

module {
  func.func @mte_l1_l0a_3d_rejects_m_start_with_default_repeat(
      %src: !pto.ptr<f16, mat>, %dst: !pto.ptr<f16, left>) {
    %c0 = arith.constant 0 : i64
    %c1 = arith.constant 1 : i64
    %c2 = arith.constant 2 : i64
    %c4 = arith.constant 4 : i64
    %c8 = arith.constant 8 : i64
    %c16 = arith.constant 16 : i64
    // M = 8x8 = 64, repeat_time=2, chunk=32, m_start=4: with the default
    // derived rss (ceil(32/16)=2 16-row blocks) the window 4+32+32=68 exceeds
    // the M extent 64. The explicit-stride path allows split windows, the
    // default-derived path must not silently read past the extent.
    pto.mte_l1_l0a_3d %src, %dst, %c8, %c8, %c1, %c1, %c16, %c1, %c1, %c1, %c1, %c0, %c0, %c0, %c0, %c4, %c0, %c2, %c0, %c0
      : !pto.ptr<f16, mat>, !pto.ptr<f16, left>
    return
  }
}

// CHECK: 'pto.mte_l1_l0a_3d' op repeat window exceeds the derived M extent: m_start=4, repeat_source_stride=2 (derived 16-row blocks), repeat_time=2, chunk=32, M extent=64

// -----

module {
  func.func @mte_l1_l0a_3d_rejects_upper_filter(
      %src: !pto.ptr<f16, mat>, %dst: !pto.ptr<f16, left>) {
    %c0 = arith.constant 0 : i64
    %c1 = arith.constant 1 : i64
    %c3 = arith.constant 3 : i64
    %c8 = arith.constant 8 : i64
    %c16 = arith.constant 16 : i64
    %c512 = arith.constant 512 : i64
    pto.mte_l1_l0a_3d %src, %dst, %c8, %c8, %c512, %c3, %c16, %c1, %c1, %c1, %c1, %c0, %c0, %c0, %c0, %c0, %c0, %c1, %c0, %c0
      : !pto.ptr<f16, mat>, !pto.ptr<f16, left>
    return
  }
}

// CHECK: 'pto.mte_l1_l0a_3d' op filter_h must be <= 511 to fit the hardware control field
