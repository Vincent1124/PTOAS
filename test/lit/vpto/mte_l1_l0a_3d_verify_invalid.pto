// RUN: not pto-test-opt %s -split-input-file 2>&1 | FileCheck %s

module {
  func.func @mte_l1_l0a_3d_rejects_zero_repeat(
      %src: !pto.ptr<f16, mat>, %dst: !pto.ptr<f16, left>) {
    %c0 = arith.constant 0 : i64
    %c1 = arith.constant 1 : i64
    %c3 = arith.constant 3 : i64
    %c8 = arith.constant 8 : i64
    %c16 = arith.constant 16 : i64
    pto.mte_l1_l0a_3d %src, %dst, %c8, %c8, %c3, %c3, %c16, %c1, %c1, %c1, %c1, %c0, %c0, %c0, %c0, %c0, %c0, %c0, %c0, %c0
      : !pto.ptr<f16, mat>, !pto.ptr<f16, left>
    return
  }
}

// CHECK: 'pto.mte_l1_l0a_3d' op repeat_time must be greater than zero

// -----

module {
  func.func @mte_l1_l0a_3d_rejects_small_padded_fmap(
      %src: !pto.ptr<f16, mat>, %dst: !pto.ptr<f16, left>) {
    %c0 = arith.constant 0 : i64
    %c1 = arith.constant 1 : i64
    %c2 = arith.constant 2 : i64
    %c3 = arith.constant 3 : i64
    %c16 = arith.constant 16 : i64
    pto.mte_l1_l0a_3d %src, %dst, %c2, %c2, %c3, %c3, %c16, %c1, %c1, %c1, %c1, %c0, %c0, %c0, %c0, %c0, %c0, %c1, %c0, %c0
      : !pto.ptr<f16, mat>, !pto.ptr<f16, left>
    return
  }
}

