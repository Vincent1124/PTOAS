// RUN: pto-test-opt %s -vmi-lower-unified-to-legacy -vmi-mask-granularity-assignment -vmi-layout-assignment -vmi-to-vpto | FileCheck %s --implicit-check-not=pto.vmi. --implicit-check-not='!pto.vmi.'

// A loop-carried maximum feeds integer exponent extraction and two stores.
// Separate mask and broadcast roots must not multiply the search frontier
// before their consumers close the corresponding producer cones.
module {
  func.func @quantization_loop_frontier(
      %src: !pto.ptr<bf16, ub>, %scale: !pto.ptr<f32, ub>,
      %packed: !pto.ptr<ui8, ub>) {
    %c0 = arith.constant 0 : index
    %c1 = arith.constant 1 : index
    %c4 = arith.constant 4 : index
    %c128 = arith.constant 128 : index
    %f0 = arith.constant 0.0 : f32
    %f1 = arith.constant 1.0 : f32
    %i127_raw = arith.constant 127 : i32
    %i127 = builtin.unrealized_conversion_cast %i127_raw : i32 to ui32
    %i23_raw = arith.constant 23 : i32
    %i23 = builtin.unrealized_conversion_cast %i23_raw : i32 to ui32
    %i254_raw = arith.constant 254 : i32
    %i254 = builtin.unrealized_conversion_cast %i254_raw : i32 to ui32
    %zero = pto.vmi.vbrc %f0 : f32 -> !pto.vmi.vreg<128xf32>
    %one = pto.vmi.vbrc %f1 : f32 -> !pto.vmi.vreg<128xf32>
    %bias = pto.vmi.vbrc %i127 : ui32 -> !pto.vmi.vreg<128xui32>
    %shift = pto.vmi.vbrc %i23 : ui32 -> !pto.vmi.vreg<128xui32>
    %limit = pto.vmi.vbrc %i254 : ui32 -> !pto.vmi.vreg<128xui32>
    %max = scf.for %i = %c0 to %c4 step %c1 iter_args(%acc = %zero) -> (!pto.vmi.vreg<128xf32>) {
      %off = arith.muli %i, %c128 : index
      %x = pto.vmi.vload %src[%off] : !pto.ptr<bf16, ub> -> !pto.vmi.vreg<128xbf16>
      %wide = pto.vmi.vcvt %x : !pto.vmi.vreg<128xbf16> -> !pto.vmi.vreg<128xf32>
      %abs_mask = pto.vmi.create_mask %c128 : index -> !pto.vmi.mask<128xpred>
      %abs = pto.vmi.vabs %wide, %abs_mask : !pto.vmi.vreg<128xf32>, !pto.vmi.mask<128xpred> -> !pto.vmi.vreg<128xf32>
      %max_mask = pto.vmi.create_mask %c128 : index -> !pto.vmi.mask<128xpred>
      %next = pto.vmi.vmax %acc, %abs, %max_mask : !pto.vmi.vreg<128xf32>, !pto.vmi.vreg<128xf32>, !pto.vmi.mask<128xpred> -> !pto.vmi.vreg<128xf32>
      scf.yield %next : !pto.vmi.vreg<128xf32>
    }
    %mul_mask = pto.vmi.create_mask %c128 : index -> !pto.vmi.mask<128xpred>
    %scaled = pto.vmi.vmul %max, %one, %mul_mask : !pto.vmi.vreg<128xf32>, !pto.vmi.vreg<128xf32>, !pto.vmi.mask<128xpred> -> !pto.vmi.vreg<128xf32>
    %bits = pto.vmi.vinterpret_cast %scaled : !pto.vmi.vreg<128xf32> -> !pto.vmi.vreg<128xui32>
    %a = pto.vmi.vsub %bits, %bias : !pto.vmi.vreg<128xui32>, !pto.vmi.vreg<128xui32> -> !pto.vmi.vreg<128xui32>
    %b = pto.vmi.vshr %a, %shift : !pto.vmi.vreg<128xui32>, !pto.vmi.vreg<128xui32> -> !pto.vmi.vreg<128xui32>
    %bias_add = pto.vmi.vbrc %i127 : ui32 -> !pto.vmi.vreg<128xui32>
    %c = pto.vmi.vadd %b, %bias_add : !pto.vmi.vreg<128xui32>, !pto.vmi.vreg<128xui32> -> !pto.vmi.vreg<128xui32>
    %bytes = pto.vmi.vcvt %c {saturate = "SAT"} : !pto.vmi.vreg<128xui32> -> !pto.vmi.vreg<128xui8>
    pto.vmi.vstore %bytes, %packed[%c0] : !pto.vmi.vreg<128xui8>, !pto.ptr<ui8, ub>
    %d = pto.vmi.vsub %limit, %c : !pto.vmi.vreg<128xui32>, !pto.vmi.vreg<128xui32> -> !pto.vmi.vreg<128xui32>
    %shift_out = pto.vmi.vbrc %i23 : ui32 -> !pto.vmi.vreg<128xui32>
    %e = pto.vmi.vshl %d, %shift_out : !pto.vmi.vreg<128xui32>, !pto.vmi.vreg<128xui32> -> !pto.vmi.vreg<128xui32>
    %factor = pto.vmi.vinterpret_cast %e : !pto.vmi.vreg<128xui32> -> !pto.vmi.vreg<128xf32>
    pto.vmi.vstore %factor, %scale[%c0] : !pto.vmi.vreg<128xf32>, !pto.ptr<f32, ub>
    return
  }
}

// CHECK-LABEL: func.func @quantization_loop_frontier(
// CHECK: %[[LOOP:.*]]:2 = scf.for
// CHECK-SAME: -> (!pto.vreg<64xf32>, !pto.vreg<64xf32>)
// CHECK: pto.vlds
// CHECK: pto.vabs
// CHECK: pto.vmax
// CHECK: scf.yield
// CHECK: pto.vmul %[[LOOP]]#0
// CHECK: pto.vbitcast
// CHECK: pto.vshr
// CHECK: pto.vadd
// CHECK: pto.vcvt
// CHECK-SAME: -> !pto.vreg<256xui8>
// CHECK: pto.vsts
// CHECK-SAME: dist = "PK4_B32"
// CHECK: pto.vshl
// CHECK: pto.vbitcast
// CHECK: pto.vsts
// CHECK-SAME: !pto.ptr<f32, ub>
// CHECK: return
