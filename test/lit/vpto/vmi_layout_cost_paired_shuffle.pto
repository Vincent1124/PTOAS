// RUN: pto-test-opt %s -vmi-lower-unified-to-legacy -vmi-mask-granularity-assignment -vmi-layout-assignment | FileCheck %s --check-prefix=ASSIGN
// RUN: pto-test-opt %s -vmi-lower-unified-to-legacy -vmi-mask-granularity-assignment -vmi-layout-assignment -vmi-to-vpto | FileCheck %s --check-prefix=LOWER --implicit-check-not=pto.vmi.

// Two contiguous F32 parts feed one low/high U16 pair. The cost graph must
// admit this width-changing arity and price one vdintlv, so it does not insert
// a gratuitous layout round trip. At 256 lanes d2 folds into paired
// loads/stores at the same shuffle cost. Test the inverse vzip as well.
module {
  func.func @paired_shuffle(%src: !pto.ptr<f32, ub>, %out: !pto.ptr<f32, ub>) {
    %c0 = arith.constant 0 : index
    %x = pto.vmi.vload %src[%c0] : !pto.ptr<f32, ub> -> !pto.vmi.vreg<128xf32>
    %low, %high = pto.vmi.vunzip %x : !pto.vmi.vreg<128xf32> -> !pto.vmi.vreg<128xui16>, !pto.vmi.vreg<128xui16>
    %y = pto.vmi.vzip %low, %high : !pto.vmi.vreg<128xui16>, !pto.vmi.vreg<128xui16> -> !pto.vmi.vreg<128xf32>
    pto.vmi.vstore %y, %out[%c0] : !pto.vmi.vreg<128xf32>, !pto.ptr<f32, ub>
    return
  }
  func.func @paired_shuffle_64(%src: !pto.ptr<f32, ub>, %out: !pto.ptr<f32, ub>) {
    %c0 = arith.constant 0 : index
    %x = pto.vmi.vload %src[%c0] : !pto.ptr<f32, ub> -> !pto.vmi.vreg<64xf32>
    %low, %high = pto.vmi.vunzip %x : !pto.vmi.vreg<64xf32> -> !pto.vmi.vreg<64xui16>, !pto.vmi.vreg<64xui16>
    %y = pto.vmi.vzip %low, %high : !pto.vmi.vreg<64xui16>, !pto.vmi.vreg<64xui16> -> !pto.vmi.vreg<64xf32>
    pto.vmi.vstore %y, %out[%c0] : !pto.vmi.vreg<64xf32>, !pto.ptr<f32, ub>
    return
  }
  func.func @paired_shuffle_256(%src: !pto.ptr<f32, ub>, %out: !pto.ptr<f32, ub>) {
    %c0 = arith.constant 0 : index
    %x = pto.vmi.vload %src[%c0] : !pto.ptr<f32, ub> -> !pto.vmi.vreg<256xf32>
    %low, %high = pto.vmi.vunzip %x : !pto.vmi.vreg<256xf32> -> !pto.vmi.vreg<256xui16>, !pto.vmi.vreg<256xui16>
    %y = pto.vmi.vzip %low, %high : !pto.vmi.vreg<256xui16>, !pto.vmi.vreg<256xui16> -> !pto.vmi.vreg<256xf32>
    pto.vmi.vstore %y, %out[%c0] : !pto.vmi.vreg<256xf32>, !pto.ptr<f32, ub>
    return
  }
}
// ASSIGN-LABEL: func.func @paired_shuffle(
// ASSIGN: pto.vmi.load
// ASSIGN-SAME: -> !pto.vmi.vreg<128xf32, #pto.vmi.layout<contiguous>>
// ASSIGN-NOT: ensure_layout
// ASSIGN: pto.vmi.vunzip
// ASSIGN-SAME: !pto.vmi.vreg<128xui16, #pto.vmi.layout<contiguous>>
// ASSIGN-NOT: ensure_layout
// ASSIGN: pto.vmi.vzip
// ASSIGN-SAME: -> !pto.vmi.vreg<128xf32, #pto.vmi.layout<contiguous>>
// ASSIGN-NOT: ensure_layout
// ASSIGN: pto.vmi.store
// LOWER-LABEL: func.func @paired_shuffle(
// LOWER: pto.vdintlv
// LOWER-NOT: pto.vdintlv
// LOWER: pto.vintlv
// LOWER-NOT: pto.vintlv
// LOWER: pto.vsts
// ASSIGN-LABEL: func.func @paired_shuffle_64(
// ASSIGN: pto.vmi.load
// ASSIGN-SAME: -> !pto.vmi.vreg<64xf32, #pto.vmi.layout<contiguous>>
// ASSIGN-NOT: ensure_layout
// ASSIGN: pto.vmi.vunzip
// ASSIGN-SAME: !pto.vmi.vreg<64xui16, #pto.vmi.layout<contiguous>>
// ASSIGN-NOT: ensure_layout
// ASSIGN: pto.vmi.vzip
// ASSIGN-SAME: -> !pto.vmi.vreg<64xf32, #pto.vmi.layout<contiguous>>
// ASSIGN-NOT: ensure_layout
// ASSIGN: pto.vmi.store
// LOWER-LABEL: func.func @paired_shuffle_64(
// LOWER: pto.vdintlv
// LOWER-NOT: pto.vdintlv
// LOWER: pto.vintlv
// LOWER-NOT: pto.vintlv
// LOWER: pto.vsts
// ASSIGN-LABEL: func.func @paired_shuffle_256(
// ASSIGN: pto.vmi.load
// ASSIGN-SAME: -> !pto.vmi.vreg<256xf32, #pto.vmi.layout<deinterleaved = 2>>
// ASSIGN-NOT: ensure_layout
// ASSIGN: pto.vmi.vunzip
// ASSIGN-SAME: !pto.vmi.vreg<256xui16, #pto.vmi.layout<deinterleaved = 2>>
// ASSIGN-NOT: ensure_layout
// ASSIGN: pto.vmi.vzip
// ASSIGN-SAME: -> !pto.vmi.vreg<256xf32, #pto.vmi.layout<deinterleaved = 2>>
// ASSIGN-NOT: ensure_layout
// ASSIGN: pto.vmi.store
// LOWER-LABEL: func.func @paired_shuffle_256(
// LOWER-COUNT-2: pto.vldsx2 {{.*}}"DINTLV_B32"
// LOWER-NOT: pto.vldsx2
// LOWER-COUNT-2: pto.vdintlv
// LOWER-NOT: pto.vdintlv
// LOWER-COUNT-2: pto.vintlv
// LOWER-NOT: pto.vintlv
// LOWER-COUNT-2: pto.vstsx2 {{.*}}"INTLV_B32"
// LOWER-NOT: pto.vsts
// LOWER: return
