module {
  func.func @control_flow_for_yield_first(%arg0: i1, %arg1: index, %arg2: f32, %arg3: f32, %arg4: !pto.ptr<f32, ub>) {
    %c0 = arith.constant 0 : index
    %c1 = arith.constant 1 : index
    %c2 = arith.constant 2 : index
    %0 = pto.vmi.broadcast %arg3 : f32 -> !pto.vmi.vreg<128xf32>
    %1 = pto.vmi.broadcast %arg2 : f32 -> !pto.vmi.vreg<128xf32>
    %2 = scf.for %arg5 = %c0 to %c2 step %c1 iter_args(%arg6 = %1) -> (!pto.vmi.vreg<128xf32>) {
      scf.yield %0 : !pto.vmi.vreg<128xf32>
    }
    pto.vmi.store %2, %arg4[%c0] : !pto.vmi.vreg<128xf32>, !pto.ptr<f32, ub>
    return
  }
}


// ASSIGN-LABEL: func.func @control_flow_if(
// ASSIGN: pto.vmi.broadcast{{.*}} -> !pto.vmi.vreg<128xf32, #pto.vmi.layout<deinterleaved = 2>>
// ASSIGN: pto.vmi.store{{.*}} : !pto.vmi.vreg<128xf32, #pto.vmi.layout<deinterleaved = 2>>
// LOWER-LABEL: func.func @control_flow_if(
// LOWER: pto.vdup
// LOWER: pto.vstsx2{{.*}} "INTLV_B32"
module {
  func.func @control_flow_if(%arg0: i1, %arg1: index, %arg2: f32, %arg3: f32, %arg4: !pto.ptr<f32, ub>) {
    %c0 = arith.constant 0 : index
    %c1 = arith.constant 1 : index
    %c2 = arith.constant 2 : index
    %0 = pto.vmi.broadcast %arg2 : f32 -> !pto.vmi.vreg<128xf32>
    %1 = pto.vmi.broadcast %arg3 : f32 -> !pto.vmi.vreg<128xf32>
    %2 = scf.if %arg0 -> (!pto.vmi.vreg<128xf32>) {
      scf.yield %0 : !pto.vmi.vreg<128xf32>
    } else {
      scf.yield %1 : !pto.vmi.vreg<128xf32>
    }
    pto.vmi.store %2, %arg4[%c0] : !pto.vmi.vreg<128xf32>, !pto.ptr<f32, ub>
    return
  }
}


// ASSIGN-LABEL: func.func @control_flow_if_inside(
// ASSIGN: pto.vmi.broadcast{{.*}} -> !pto.vmi.vreg<128xf32, #pto.vmi.layout<deinterleaved = 2>>
// ASSIGN: pto.vmi.store{{.*}} : !pto.vmi.vreg<128xf32, #pto.vmi.layout<deinterleaved = 2>>
// LOWER-LABEL: func.func @control_flow_if_inside(
// LOWER: pto.vdup
// LOWER: pto.vstsx2{{.*}} "INTLV_B32"
module {
  func.func @control_flow_if_inside(%arg0: i1, %arg1: index, %arg2: f32, %arg3: f32, %arg4: !pto.ptr<f32, ub>) {
    %c0 = arith.constant 0 : index
    %c1 = arith.constant 1 : index
    %c2 = arith.constant 2 : index
    %0 = scf.if %arg0 -> (!pto.vmi.vreg<128xf32>) {
      %1 = pto.vmi.broadcast %arg2 : f32 -> !pto.vmi.vreg<128xf32>
      scf.yield %1 : !pto.vmi.vreg<128xf32>
    } else {
      %1 = pto.vmi.broadcast %arg3 : f32 -> !pto.vmi.vreg<128xf32>
      scf.yield %1 : !pto.vmi.vreg<128xf32>
    }
    pto.vmi.store %0, %arg4[%c0] : !pto.vmi.vreg<128xf32>, !pto.ptr<f32, ub>
    return
  }
}


// ASSIGN-LABEL: func.func @control_flow_if_nested(
// ASSIGN: pto.vmi.broadcast{{.*}} -> !pto.vmi.vreg<128xf32, #pto.vmi.layout<deinterleaved = 2>>
// ASSIGN: pto.vmi.store{{.*}} : !pto.vmi.vreg<128xf32, #pto.vmi.layout<deinterleaved = 2>>
// LOWER-LABEL: func.func @control_flow_if_nested(
// LOWER: pto.vdup
// LOWER: pto.vstsx2{{.*}} "INTLV_B32"
module {
  func.func @control_flow_if_nested(%arg0: i1, %arg1: index, %arg2: f32, %arg3: f32, %arg4: !pto.ptr<f32, ub>) {
    %c0 = arith.constant 0 : index
    %c1 = arith.constant 1 : index
    %c2 = arith.constant 2 : index
    %0 = pto.vmi.broadcast %arg2 : f32 -> !pto.vmi.vreg<128xf32>
    %1 = pto.vmi.broadcast %arg3 : f32 -> !pto.vmi.vreg<128xf32>
    %2 = scf.if %arg0 -> (!pto.vmi.vreg<128xf32>) {
      %3 = scf.if %arg0 -> (!pto.vmi.vreg<128xf32>) {
        scf.yield %0 : !pto.vmi.vreg<128xf32>
      } else {
        scf.yield %1 : !pto.vmi.vreg<128xf32>
      }
      scf.yield %3 : !pto.vmi.vreg<128xf32>
    } else {
      scf.yield %1 : !pto.vmi.vreg<128xf32>
    }
    pto.vmi.store %2, %arg4[%c0] : !pto.vmi.vreg<128xf32>, !pto.ptr<f32, ub>
    return
  }
}


// ASSIGN-LABEL: func.func @control_flow_if_reversed(
// ASSIGN: pto.vmi.broadcast{{.*}} -> !pto.vmi.vreg<128xf32, #pto.vmi.layout<deinterleaved = 2>>
// ASSIGN: pto.vmi.store{{.*}} : !pto.vmi.vreg<128xf32, #pto.vmi.layout<deinterleaved = 2>>
// LOWER-LABEL: func.func @control_flow_if_reversed(
// LOWER: pto.vdup
// LOWER: pto.vstsx2{{.*}} "INTLV_B32"
module {
  func.func @control_flow_if_reversed(%arg0: i1, %arg1: index, %arg2: f32, %arg3: f32, %arg4: !pto.ptr<f32, ub>) {
    %c0 = arith.constant 0 : index
    %c1 = arith.constant 1 : index
    %c2 = arith.constant 2 : index
    %0 = pto.vmi.broadcast %arg3 : f32 -> !pto.vmi.vreg<128xf32>
    %1 = pto.vmi.broadcast %arg2 : f32 -> !pto.vmi.vreg<128xf32>
    %2 = scf.if %arg0 -> (!pto.vmi.vreg<128xf32>) {
      scf.yield %1 : !pto.vmi.vreg<128xf32>
    } else {
      scf.yield %0 : !pto.vmi.vreg<128xf32>
    }
    pto.vmi.store %2, %arg4[%c0] : !pto.vmi.vreg<128xf32>, !pto.ptr<f32, ub>
    return
  }
}


// ASSIGN-LABEL: func.func @control_flow_index_switch(
// ASSIGN: pto.vmi.broadcast{{.*}} -> !pto.vmi.vreg<128xf32, #pto.vmi.layout<deinterleaved = 2>>
// ASSIGN: pto.vmi.store{{.*}} : !pto.vmi.vreg<128xf32, #pto.vmi.layout<deinterleaved = 2>>
// LOWER-LABEL: func.func @control_flow_index_switch(
// LOWER: pto.vdup
// LOWER: pto.vstsx2{{.*}} "INTLV_B32"
module {
  func.func @control_flow_index_switch(%arg0: i1, %arg1: index, %arg2: f32, %arg3: f32, %arg4: !pto.ptr<f32, ub>) {
    %c0 = arith.constant 0 : index
    %c1 = arith.constant 1 : index
    %c2 = arith.constant 2 : index
    %0 = pto.vmi.broadcast %arg2 : f32 -> !pto.vmi.vreg<128xf32>
    %1 = pto.vmi.broadcast %arg3 : f32 -> !pto.vmi.vreg<128xf32>
    %2 = scf.index_switch %arg1 -> !pto.vmi.vreg<128xf32>
    case 0 {
      scf.yield %0 : !pto.vmi.vreg<128xf32>
    }
    default {
      scf.yield %1 : !pto.vmi.vreg<128xf32>
    }
    pto.vmi.store %2, %arg4[%c0] : !pto.vmi.vreg<128xf32>, !pto.ptr<f32, ub>
    return
  }
}


// ASSIGN-LABEL: func.func @control_flow_while(
// ASSIGN: pto.vmi.broadcast{{.*}} -> !pto.vmi.vreg<128xf32, #pto.vmi.layout<deinterleaved = 2>>
// ASSIGN: pto.vmi.store{{.*}} : !pto.vmi.vreg<128xf32, #pto.vmi.layout<deinterleaved = 2>>
// LOWER-LABEL: func.func @control_flow_while(
// LOWER: pto.vdup
// LOWER: pto.vstsx2{{.*}} "INTLV_B32"
module {
  func.func @control_flow_while(%arg0: i1, %arg1: index, %arg2: f32, %arg3: f32, %arg4: !pto.ptr<f32, ub>) {
    %c0 = arith.constant 0 : index
    %c1 = arith.constant 1 : index
    %c2 = arith.constant 2 : index
    %0 = pto.vmi.broadcast %arg3 : f32 -> !pto.vmi.vreg<128xf32>
    %1 = pto.vmi.broadcast %arg2 : f32 -> !pto.vmi.vreg<128xf32>
    %2 = scf.while (%arg5 = %1) : (!pto.vmi.vreg<128xf32>) -> !pto.vmi.vreg<128xf32> {
      scf.condition(%arg0) %arg5 : !pto.vmi.vreg<128xf32>
    } do {
    ^bb0(%arg5: !pto.vmi.vreg<128xf32>):
      scf.yield %0 : !pto.vmi.vreg<128xf32>
    }
    pto.vmi.store %2, %arg4[%c0] : !pto.vmi.vreg<128xf32>, !pto.ptr<f32, ub>
    return
  }
}
