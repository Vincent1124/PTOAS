// RUN: pto-test-opt %s -vmi-layout-assignment | FileCheck %s --check-prefix=ASSIGN --implicit-check-not=pto.vmi.ensure_layout
// RUN: pto-test-opt %s -vmi-layout-assignment -vmi-to-vpto | FileCheck %s --check-prefix=LOWER --implicit-check-not=pto.vintlv --implicit-check-not=pto.vdintlv --implicit-check-not=pto.vmi.

// Independent producers must share the control-flow component with their
// consumers, regardless of definition order, block order or region nesting.
// All broadcasts can directly produce the store's D2 layout. No conversion
// may be inserted after solving to repair a disconnected control-flow edge.

// ASSIGN-LABEL: func.func @control_flow_cfg_join(
// ASSIGN: pto.vmi.broadcast{{.*}} -> !pto.vmi.vreg<128xf32, #pto.vmi.layout<deinterleaved = 2>>
// ASSIGN: pto.vmi.store{{.*}} : !pto.vmi.vreg<128xf32, #pto.vmi.layout<deinterleaved = 2>>
// LOWER-LABEL: func.func @control_flow_cfg_join(
// LOWER: pto.vdup
// LOWER: pto.vstsx2{{.*}} "INTLV_B32"
module {
  func.func @control_flow_cfg_join(%arg0: i1, %arg1: index, %arg2: f32, %arg3: f32, %arg4: !pto.ptr<f32, ub>) {
    %c0 = arith.constant 0 : index
    %c1 = arith.constant 1 : index
    %c2 = arith.constant 2 : index
    cf.cond_br %arg0, ^bb1, ^bb2
  ^bb1:  // pred: ^bb0
    %0 = pto.vmi.broadcast %arg2 : f32 -> !pto.vmi.vreg<128xf32>
    cf.br ^bb3(%0 : !pto.vmi.vreg<128xf32>)
  ^bb2:  // pred: ^bb0
    %1 = pto.vmi.broadcast %arg3 : f32 -> !pto.vmi.vreg<128xf32>
    cf.br ^bb3(%1 : !pto.vmi.vreg<128xf32>)
  ^bb3(%2: !pto.vmi.vreg<128xf32>):  // 2 preds: ^bb1, ^bb2
    pto.vmi.store %2, %arg4[%c0] : !pto.vmi.vreg<128xf32>, !pto.ptr<f32, ub>
    return
  }
}


// ASSIGN-LABEL: func.func @control_flow_cfg_join_reversed(
// ASSIGN: pto.vmi.broadcast{{.*}} -> !pto.vmi.vreg<128xf32, #pto.vmi.layout<deinterleaved = 2>>
// ASSIGN: pto.vmi.store{{.*}} : !pto.vmi.vreg<128xf32, #pto.vmi.layout<deinterleaved = 2>>
// LOWER-LABEL: func.func @control_flow_cfg_join_reversed(
// LOWER: pto.vdup
// LOWER: pto.vstsx2{{.*}} "INTLV_B32"
module {
  func.func @control_flow_cfg_join_reversed(%arg0: i1, %arg1: index, %arg2: f32, %arg3: f32, %arg4: !pto.ptr<f32, ub>) {
    %c0 = arith.constant 0 : index
    %c1 = arith.constant 1 : index
    %c2 = arith.constant 2 : index
    cf.cond_br %arg0, ^bb2, ^bb1
  ^bb1:  // pred: ^bb0
    %0 = pto.vmi.broadcast %arg3 : f32 -> !pto.vmi.vreg<128xf32>
    cf.br ^bb3(%0 : !pto.vmi.vreg<128xf32>)
  ^bb2:  // pred: ^bb0
    %1 = pto.vmi.broadcast %arg2 : f32 -> !pto.vmi.vreg<128xf32>
    cf.br ^bb3(%1 : !pto.vmi.vreg<128xf32>)
  ^bb3(%2: !pto.vmi.vreg<128xf32>):  // 2 preds: ^bb1, ^bb2
    pto.vmi.store %2, %arg4[%c0] : !pto.vmi.vreg<128xf32>, !pto.ptr<f32, ub>
    return
  }
}


// ASSIGN-LABEL: func.func @control_flow_execute(
// ASSIGN: pto.vmi.broadcast{{.*}} -> !pto.vmi.vreg<128xf32, #pto.vmi.layout<deinterleaved = 2>>
// ASSIGN: pto.vmi.store{{.*}} : !pto.vmi.vreg<128xf32, #pto.vmi.layout<deinterleaved = 2>>
// LOWER-LABEL: func.func @control_flow_execute(
// LOWER: pto.vdup
// LOWER: pto.vstsx2{{.*}} "INTLV_B32"
module {
  func.func @control_flow_execute(%arg0: i1, %arg1: index, %arg2: f32, %arg3: f32, %arg4: !pto.ptr<f32, ub>) {
    %c0 = arith.constant 0 : index
    %c1 = arith.constant 1 : index
    %c2 = arith.constant 2 : index
    %0 = pto.vmi.broadcast %arg2 : f32 -> !pto.vmi.vreg<128xf32>
    %1 = scf.execute_region -> !pto.vmi.vreg<128xf32> {
      scf.yield %0 : !pto.vmi.vreg<128xf32>
    }
    pto.vmi.store %1, %arg4[%c0] : !pto.vmi.vreg<128xf32>, !pto.ptr<f32, ub>
    return
  }
}


// ASSIGN-LABEL: func.func @control_flow_for_init_first(
// ASSIGN: pto.vmi.broadcast{{.*}} -> !pto.vmi.vreg<128xf32, #pto.vmi.layout<deinterleaved = 2>>
// ASSIGN: pto.vmi.store{{.*}} : !pto.vmi.vreg<128xf32, #pto.vmi.layout<deinterleaved = 2>>
// LOWER-LABEL: func.func @control_flow_for_init_first(
// LOWER: pto.vdup
// LOWER: pto.vstsx2{{.*}} "INTLV_B32"
module {
  func.func @control_flow_for_init_first(%arg0: i1, %arg1: index, %arg2: f32, %arg3: f32, %arg4: !pto.ptr<f32, ub>) {
    %c0 = arith.constant 0 : index
    %c1 = arith.constant 1 : index
    %c2 = arith.constant 2 : index
    %0 = pto.vmi.broadcast %arg2 : f32 -> !pto.vmi.vreg<128xf32>
    %1 = pto.vmi.broadcast %arg3 : f32 -> !pto.vmi.vreg<128xf32>
    %2 = scf.for %arg5 = %c0 to %c2 step %c1 iter_args(%arg6 = %0) -> (!pto.vmi.vreg<128xf32>) {
      scf.yield %1 : !pto.vmi.vreg<128xf32>
    }
    pto.vmi.store %2, %arg4[%c0] : !pto.vmi.vreg<128xf32>, !pto.ptr<f32, ub>
    return
  }
}


// ASSIGN-LABEL: func.func @control_flow_for_yield_first(
// ASSIGN: pto.vmi.broadcast{{.*}} -> !pto.vmi.vreg<128xf32, #pto.vmi.layout<deinterleaved = 2>>
// ASSIGN: pto.vmi.store{{.*}} : !pto.vmi.vreg<128xf32, #pto.vmi.layout<deinterleaved = 2>>
// LOWER-LABEL: func.func @control_flow_for_yield_first(
