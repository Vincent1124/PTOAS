// CHECK-LABEL: define void @mte_l1_l0a_3d_u8_mix_aic
// CHECK: call void @llvm.hivm.SET.FMATRIX(i64 524296)
// CHECK-NEXT: call void @llvm.hivm.SET.PADDING(i64 0)
// CHECK-NEXT: call void @llvm.hivm.SET.L3D.RPT(i64 12884967427)
// CHECK-NEXT: call void @llvm.hivm.LOAD.L1.TO.L0A.3DV2.c310.u8.C310.NO.DUAL({{.*}}, {{.*}}, i64 2359456, i64 4503668618440769)

// CHECK-LABEL: define void @mte_l1_l0a_3d_asym_mix_aic
// CHECK: call void @llvm.hivm.SET.FMATRIX(i64 524296)
// CHECK-NEXT: call void @llvm.hivm.SET.PADDING(i64 0)
// CHECK-NEXT: call void @llvm.hivm.SET.L3D.RPT(i64 8590000130)
// CHECK-NEXT: call void @llvm.hivm.LOAD.L1.TO.L0A.3DV2.c310.f16.C310.NO.DUAL({{.*}}, {{.*}}, i64 1179744, i64 4503737336868993)

// CHECK-LABEL: define void @mte_l1_l0a_3d_filter_256_mix_aic
// CHECK: call void @llvm.hivm.SET.FMATRIX(i64 1048832)
// CHECK-NEXT: call void @llvm.hivm.SET.PADDING(i64 0)
// CHECK-NEXT: call void @llvm.hivm.SET.L3D.RPT(i64 4295032833)
// CHECK-NEXT: call void @llvm.hivm.LOAD.L1.TO.L0A.3DV2.c310.f16.C310.NO.DUAL({{.*}}, {{.*}}, i64 1048832, i64 299136151715905)

// CHECK-LABEL: define void @mte_l1_l0a_3d_transpose_mix_aic
// CHECK: call void @llvm.hivm.SET.FMATRIX(i64 524296)
// CHECK-NEXT: call void @llvm.hivm.SET.PADDING(i64 0)
// CHECK-NEXT: call void @llvm.hivm.SET.L3D.RPT(i64 12884967427)
// CHECK-NEXT: call void @llvm.hivm.LOAD.L1.TO.L0A.3DV2.c310.f16.C310.NO.DUAL({{.*}}, {{.*}}, i64 2359440, i64 4574037362618433)

// CHECK-LABEL: define void @mte_l1_l0a_3d_dynamic_mix_aic
