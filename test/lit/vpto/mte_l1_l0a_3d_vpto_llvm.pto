// CHECK: call void @llvm.hivm.SET.PADDING(i64 0)
// CHECK: call void @llvm.hivm.SET.L3D.RPT(i64 %{{.*}})
// CHECK: call void @llvm.hivm.LOAD.L1.TO.L0A.3DV2.c310.f16.C310.NO.DUAL({{.*}}, {{.*}}, i64 %{{.*}}, i64 %{{.*}})
