// CHECK-NEXT: call void @llvm.hivm.LOAD.L1.TO.L0A.3DV2.c310.f32.C310.NO.DUAL({{.*}}, {{.*}}, i64 2359440, i64 4503668618440769)

// CHECK-LABEL: define void @mte_l1_l0a_3d_s8_mix_aic
// CHECK: call void @llvm.hivm.SET.FMATRIX(i64 524296)
// CHECK-NEXT: call void @llvm.hivm.SET.PADDING(i64 0)
// CHECK-NEXT: call void @llvm.hivm.SET.L3D.RPT(i64 12884967427)
