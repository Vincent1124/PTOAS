// RUN: ptoas --pto-arch=a5 --pto-backend=vpto --emit-vpto --mlir-print-ir-after=pto-expand-tile-op %s -o /dev/null 2>&1 | FileCheck %s --check-prefix=SELECT

// The tile dispatch selects the same software implementations as the vector
// path: ``diff_compensation`` and ``precision_0ulp_ftz_true`` share the
// compensated residual search, ``precision_0ulp_ftz_false`` uses the normalized
// IEEE-754 path, and f16 only supports ``precision_1ulp_ftz_false`` — the 0-ULP
// algorithms are f32-only, exactly like the AscendC static_assert.

module attributes {pto.kernel_kind = #pto.kernel_kind<vector>} {
  func.func @TDIV_DIFF_COMPENSATION() {
    %lhs = pto.alloc_tile
      : !pto.tile_buf<loc=vec, dtype=f32, rows=4, cols=72, v_row=4, v_col=72,
                      blayout=row_major, slayout=none_box, fractal=512, pad=0>
    %rhs = pto.alloc_tile
      : !pto.tile_buf<loc=vec, dtype=f32, rows=4, cols=72, v_row=4, v_col=72,
                      blayout=row_major, slayout=none_box, fractal=512, pad=0>
    %dst = pto.alloc_tile
      : !pto.tile_buf<loc=vec, dtype=f32, rows=4, cols=72, v_row=4, v_col=72,
                      blayout=row_major, slayout=none_box, fractal=512, pad=0>

    pto.tdiv ins(
      %lhs, %rhs
        : !pto.tile_buf<loc=vec, dtype=f32, rows=4, cols=72, v_row=4, v_col=72,
                        blayout=row_major, slayout=none_box, fractal=512, pad=0>,
          !pto.tile_buf<loc=vec, dtype=f32, rows=4, cols=72, v_row=4, v_col=72,
                        blayout=row_major, slayout=none_box, fractal=512, pad=0>)
      outs(
        %dst
          : !pto.tile_buf<loc=vec, dtype=f32, rows=4, cols=72, v_row=4, v_col=72,
                          blayout=row_major, slayout=none_box, fractal=512, pad=0>)
      {precisionType = #pto<div_precision diff_compensation>}
    return
  }

  func.func @TDIV_ULP0_FTZ_FALSE() {
    %lhs = pto.alloc_tile
      : !pto.tile_buf<loc=vec, dtype=f32, rows=4, cols=72, v_row=4, v_col=72,
                      blayout=row_major, slayout=none_box, fractal=512, pad=0>
    %rhs = pto.alloc_tile
      : !pto.tile_buf<loc=vec, dtype=f32, rows=4, cols=72, v_row=4, v_col=72,
                      blayout=row_major, slayout=none_box, fractal=512, pad=0>
    %dst = pto.alloc_tile
      : !pto.tile_buf<loc=vec, dtype=f32, rows=4, cols=72, v_row=4, v_col=72,
                      blayout=row_major, slayout=none_box, fractal=512, pad=0>

    pto.tdiv ins(
      %lhs, %rhs
        : !pto.tile_buf<loc=vec, dtype=f32, rows=4, cols=72, v_row=4, v_col=72,
                        blayout=row_major, slayout=none_box, fractal=512, pad=0>,
          !pto.tile_buf<loc=vec, dtype=f32, rows=4, cols=72, v_row=4, v_col=72,
                        blayout=row_major, slayout=none_box, fractal=512, pad=0>)
      outs(
        %dst
          : !pto.tile_buf<loc=vec, dtype=f32, rows=4, cols=72, v_row=4, v_col=72,
                          blayout=row_major, slayout=none_box, fractal=512, pad=0>)
      {precisionType = #pto<div_precision precision_0ulp_ftz_false>}
    return
  }

  func.func @TDIV_F16_1ULP_FTZ_FALSE() {
    %lhs = pto.alloc_tile
      : !pto.tile_buf<loc=vec, dtype=f16, rows=4, cols=64, v_row=4, v_col=64,
                      blayout=row_major, slayout=none_box, fractal=512, pad=0>
    %rhs = pto.alloc_tile
      : !pto.tile_buf<loc=vec, dtype=f16, rows=4, cols=64, v_row=4, v_col=64,
                      blayout=row_major, slayout=none_box, fractal=512, pad=0>
    %dst = pto.alloc_tile
      : !pto.tile_buf<loc=vec, dtype=f16, rows=4, cols=64, v_row=4, v_col=64,
                      blayout=row_major, slayout=none_box, fractal=512, pad=0>

    pto.tdiv ins(
      %lhs, %rhs
        : !pto.tile_buf<loc=vec, dtype=f16, rows=4, cols=64, v_row=4, v_col=64,
                        blayout=row_major, slayout=none_box, fractal=512, pad=0>,
          !pto.tile_buf<loc=vec, dtype=f16, rows=4, cols=64, v_row=4, v_col=64,
                        blayout=row_major, slayout=none_box, fractal=512, pad=0>)
      outs(
        %dst
          : !pto.tile_buf<loc=vec, dtype=f16, rows=4, cols=64, v_row=4, v_col=64,
                          blayout=row_major, slayout=none_box, fractal=512, pad=0>)
      {precisionType = #pto<div_precision precision_1ulp_ftz_false>}
    return
  }

}

// diff_compensation expands into the compensated residual search on f32.
// SELECT-LABEL: func.func private @{{.*}}ctx_precisionType_diff_compensation__template_tdiv
// SELECT-DAG: pto.vdiv
// SELECT-DAG: pto.vmula

// precision_0ulp_ftz_false normalises the operands before the residual search.
// SELECT-LABEL: func.func private @{{.*}}ctx_precisionType_precision_0ulp_ftz_false__template_tdiv
// SELECT-DAG: pto.vdiv
// SELECT-DAG: pto.vshl
// SELECT-DAG: pto.vshr
// SELECT-DAG: pto.vmula

// f16 uses DivIEEE754HalfImpl: a normalized divide plus the exponent fix-up and
// no residual multiply-add.
// SELECT-LABEL: func.func private @{{.*}}ctx_precisionType_precision_1ulp_ftz_false__template_tdiv
// SELECT-DAG: pto.vdiv
// SELECT-DAG: pto.vmuls
// SELECT-NOT: pto.vmula
