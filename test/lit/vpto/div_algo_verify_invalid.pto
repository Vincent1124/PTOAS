// RUN: pto-test-opt --split-input-file --verify-diagnostics %s

// The three software division algorithms expand on A5 f32 with a b32 mask, so
// every other shape must be rejected by the verifier instead of failing later
// in the SoftLib request stage. The native selectors accept any element type.

module attributes {pto.target_arch = "a5", pto.kernel_kind = #pto.kernel_kind<vector>} {
  func.func @vdiv_ulp0_ftz_false_f16(%lhs: !pto.vreg<128xf16>, %rhs: !pto.vreg<128xf16>,
                                     %mask: !pto.mask<b16>) {
    // expected-error @+1 {{precision_0ulp_ftz_false requires f32 vector operands}}
    %q = pto.vdiv %lhs, %rhs, %mask {precisionType = #pto<div_precision precision_0ulp_ftz_false>} :
      !pto.vreg<128xf16>, !pto.vreg<128xf16>, !pto.mask<b16> -> !pto.vreg<128xf16>
    return
  }
}

// -----
module attributes {pto.target_arch = "a5", pto.kernel_kind = #pto.kernel_kind<vector>} {
  func.func @vdiv_ulp1_ftz_false_f16(%lhs: !pto.vreg<128xf16>, %rhs: !pto.vreg<128xf16>,
                                     %mask: !pto.mask<b16>) {
    // expected-error @+1 {{precision_1ulp_ftz_false requires f32 vector operands}}
    %q = pto.vdiv %lhs, %rhs, %mask {precisionType = #pto<div_precision precision_1ulp_ftz_false>} :
      !pto.vreg<128xf16>, !pto.vreg<128xf16>, !pto.mask<b16> -> !pto.vreg<128xf16>
    return
  }
}

// -----
module attributes {pto.target_arch = "a5", pto.kernel_kind = #pto.kernel_kind<vector>} {
  func.func @vdiv_ulp0_ftz_false_b16_mask(%lhs: !pto.vreg<64xf32>, %rhs: !pto.vreg<64xf32>,
                                          %mask: !pto.mask<b16>) {
    // expected-error @+1 {{precision_0ulp_ftz_false f32 requires a b32 mask}}
    %q = pto.vdiv %lhs, %rhs, %mask {precisionType = #pto<div_precision precision_0ulp_ftz_false>} :
      !pto.vreg<64xf32>, !pto.vreg<64xf32>, !pto.mask<b16> -> !pto.vreg<64xf32>
    return
  }
}

// -----
module attributes {pto.target_arch = "a5"} {
  func.func @scalar_divf_ulp0_ftz_false(%lhs: f32, %rhs: f32) -> f32 {
    // expected-error @+1 {{precision_0ulp_ftz_false is not supported for scalar division; use intrinsic or precision_0ulp_ftz_true}}
    %q = pto.divf %lhs, %rhs {precisionType = #pto<div_precision precision_0ulp_ftz_false>} : f32
    return %q : f32
  }
}

// -----
module attributes {pto.target_arch = "a5"} {
  func.func @scalar_divf_ulp1_ftz_false(%lhs: f32, %rhs: f32) -> f32 {
    // expected-error @+1 {{precision_1ulp_ftz_false is not supported for scalar division; use intrinsic or precision_0ulp_ftz_true}}
    %q = pto.divf %lhs, %rhs {precisionType = #pto<div_precision precision_1ulp_ftz_false>} : f32
    return %q : f32
  }
}

// -----
module attributes {pto.target_arch = "a5"} {
  func.func @scalar_divf_0ulp_ftz_true(%lhs: f32, %rhs: f32) -> f32 {
    // The correctly-rounded scalar path stays valid.
    %q = pto.divf %lhs, %rhs {precisionType = #pto<div_precision precision_0ulp_ftz_true>} : f32
    return %q : f32
  }
}

// -----
module attributes {pto.target_arch = "a5", pto.kernel_kind = #pto.kernel_kind<vector>} {
  func.func @vdiv_native_accepts_f16(%lhs: !pto.vreg<128xf16>, %rhs: !pto.vreg<128xf16>,
                                     %mask: !pto.mask<b16>) {
    // Native selectors are a plain vector divide and accept f16.
    %q0 = pto.vdiv %lhs, %rhs, %mask {precisionType = #pto<div_precision diff_compensation>} :
      !pto.vreg<128xf16>, !pto.vreg<128xf16>, !pto.mask<b16> -> !pto.vreg<128xf16>
    %q1 = pto.vdiv %lhs, %rhs, %mask {precisionType = #pto<div_precision precision_1ulp_ftz_true>} :
      !pto.vreg<128xf16>, !pto.vreg<128xf16>, !pto.mask<b16> -> !pto.vreg<128xf16>
    return
  }
}
