// RUN: pto-test-opt %s -vmi-to-vpto | FileCheck %s

module {
  func.func @slot_load_stride4(%src: !pto.ptr<ui8, ub>, %off: index)
      -> !pto.vmi.vreg<8xui8, #pto.vmi.layout<num_groups = 8, slots = 8, lane_stride = 4>> {
    %c1 = arith.constant 1 : index
    %out = pto.vmi.group_slot_load %src[%off], %c1 {num_groups = 8}
        : !pto.ptr<ui8, ub>
        -> !pto.vmi.vreg<8xui8, #pto.vmi.layout<num_groups = 8, slots = 8, lane_stride = 4>>
    return %out : !pto.vmi.vreg<8xui8, #pto.vmi.layout<num_groups = 8, slots = 8, lane_stride = 4>>
  }
}

// CHECK-LABEL: func.func @slot_load_stride4(
// CHECK: %[[LOAD:.*]] = pto.vsldb
// CHECK: %[[HALF:.*]] = pto.vzunpack %[[LOAD]], {{.*}} : !pto.vreg<256xui8> -> !pto.vreg<128xui16>
// CHECK: %[[WORD:.*]] = pto.vzunpack %[[HALF]], {{.*}} : !pto.vreg<128xui16> -> !pto.vreg<64xui32>
// CHECK: pto.vbitcast %[[WORD]]
// CHECK-NOT: pto.vmi.
