// RUN: not ptoas --pto-arch=a5 --pto-backend=vpto %s 2>&1 | FileCheck %s

// The A5 F2F profile encodes R/A/Z for the f32 -> bf16 pair and has no
// half-up form, so the physical contract rejects rnd = "H" up front instead
// of failing in the backend instruction selector.

// CHECK: error: 'pto.vcvt' op rnd attr is not valid for this vcvt type pair

module attributes {pto.target_arch = "a5"} {
  func.func @vcvt_f32_to_bf16_half_up_unsupported(%seed: f32) {
    pto.vecscope {
      %mask_b32 = pto.pset_b32 "PAT_ALL" : !pto.mask<b32>
      %src = pto.vdup %seed, %mask_b32 : f32, !pto.mask<b32> -> !pto.vreg<64xf32>
      %half = pto.vcvt %src, %mask_b32 {rnd = "H", sat = "SAT", part = "EVEN"} : !pto.vreg<64xf32>, !pto.mask<b32> -> !pto.vreg<128xbf16>
    }
    return
  }
}
